{% extends 'default_frame.twig' %}

{% set body_class = 'product_page' %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/css/nav_shopcart.css') }}?v={{ 'now'|date('U') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/customize.css', 'user_data') }}?v={{ 'now'|date('U') }}">
{% endblock %}

{% set hasImages = Product.ProductImage|length > 0 %}
{% set firstImage = hasImages ? asset(Product.ProductImage[0].fileName, 'save_image') : asset('assets/img/top/no_image_product.png') %}

{% block javascript %}
    <script>
        eccube.classCategories = {{ class_categories_as_json(Product)|raw }};

        // 規格2に選択肢を割り当てる。
        function fnSetClassCategories(form, classcat_id2_selected) {
            var $form = $(form);
            var product_id = $form.find('input[name=product_id]').val();
            var $sele1 = $form.find('select[name=classcategory_id1]');
            var $sele2 = $form.find('select[name=classcategory_id2]');
            eccube.setClassCategories($form, product_id, $sele1, $sele2, classcat_id2_selected);
        }

        {% if form.classcategory_id2 is defined %}
        fnSetClassCategories(
            $('#form1'), {{ form.classcategory_id2.vars.value|json_encode|raw }}
        );
        {% elseif form.classcategory_id1 is defined %}
        eccube.checkStock($('#form1'), {{ Product.id }}, {{ form.classcategory_id1.vars.value|json_encode|raw }}, null);
        {% endif %}
    </script>
    <script>
        $(function() {
            // Switch main image when thumbnail is clicked
            $('.shopcart-detail-thumb').on('click', function() {
                $('.shopcart-detail-thumb').removeClass('is-active');
                $(this).addClass('is-active');
                var imgSrc = $(this).attr('data-img');
                if (imgSrc) {
                    $('#mainShowcaseImg').attr('src', imgSrc);
                }
            });

            // Quantity Stepper Controls
            $('#btnQtyMinus').on('click', function() {
                var $qty = $('#quantity');
                var $disp = $('#shopcartQtyDisplay');
                var currentVal = parseInt($qty.val(), 10) || 1;
                if (currentVal > 1) {
                    currentVal -= 1;
                    $qty.val(currentVal);
                    $disp.text(currentVal);
                }
            });

            $('#btnQtyPlus').on('click', function() {
                var $qty = $('#quantity');
                var $disp = $('#shopcartQtyDisplay');
                var currentVal = parseInt($qty.val(), 10) || 1;
                currentVal += 1;
                $qty.val(currentVal);
                $disp.text(currentVal);
            });

            // Buy Now: Add to cart and proceed directly to checkout (2-click purchase)
            $('#btnBuyNow').on('click', function(e) {
                e.preventDefault();
                {% if form.classcategory_id1 is defined %}
                if ($('#classcategory_id1').val() == '__unselected' || $('#classcategory_id1').val() == '') {
                    $('#classcategory_id1')[0].setCustomValidity('{{ 'front.product.product_class_unselected'|trans }}');
                    return true;
                }
                {% endif %}
                if (typeof loadingOverlay === 'function') {
                    loadingOverlay();
                }
                $.ajax({
                    url: $('#form1').attr('action'),
                    type: 'POST',
                    data: $('#form1').serialize(),
                    dataType: 'html'
                }).done(function() {
                    window.location.href = "{{ path('shopping') }}";
                }).fail(function() {
                    $('#form1').submit();
                });
            });

            // Add to Cart AJAX
            $('.add-cart').on('click', function(event) {
                {% if form.classcategory_id1 is defined %}
                if ($('#classcategory_id1').val() == '__unselected' || $('#classcategory_id1').val() == '') {
                    $('#classcategory_id1')[0].setCustomValidity('{{ 'front.product.product_class_unselected'|trans }}');
                    return true;
                } else {
                    $('#classcategory_id1')[0].setCustomValidity('');
                }
                {% endif %}

                {% if form.classcategory_id2 is defined %}
                if ($('#classcategory_id2').val() == '__unselected' || $('#classcategory_id2').val() == '') {
                    $('#classcategory_id2')[0].setCustomValidity('{{ 'front.product.product_class_unselected'|trans }}');
                    return true;
                } else {
                    $('#classcategory_id2')[0].setCustomValidity('');
                }
                {% endif %}

                if ($('#quantity').val() < 1) {
                    $('#quantity')[0].setCustomValidity('{{ 'front.product.invalid_quantity'|trans }}');
                    return true;
                } else {
                    $('#quantity')[0].setCustomValidity('');
                }

                event.preventDefault();
                var $form = $('#form1');
                $.ajax({
                    url: $form.attr('action'),
                    type: $form.attr('method'),
                    data: $form.serialize(),
                    dataType: 'json',
                    beforeSend: function(xhr, settings) {
                        $('.add-cart').prop('disabled', true);
                    }
                }).done(function(data) {
                    if (data.done) {
                        window.location.href = "{{ url('cart') }}";
                    } else {
                        var msg = (data.messages && data.messages.length > 0) ? data.messages.join("\n") : '{{ 'front.product.add_cart_error'|trans }}';
                        alert(msg);
                    }
                }).fail(function(data) {
                    alert('{{ 'front.product.add_cart_error'|trans }}');
                }).always(function(data) {
                    $('.add-cart').prop('disabled', false);
                });
            });
        });
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": "{{ Product.name }}",
        "image": [
            "{{ app.request.schemeAndHttpHost }}{{ firstImage }}"
        ],
        "description": "{{ Product.description_list|default(Product.name)|e('js') }}",
        "offers": {
            "@type": "Offer",
            "url": "{{ url('product_detail', {'id': Product.id}) }}",
            "priceCurrency": "{{ eccube_config.currency|default('JPY') }}",
            "price": {{ Product.getPrice02IncTaxMin|default(0) }},
            "availability": "{% if Product.stockFind %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
        }
    }
    </script>
{% endblock %}

{% block main %}
    <section class="shopcart-detail-section">
        <div class="shopcart-container">
            <!-- Breadcrumb Navigation -->
            <nav class="shopcart-breadcrumb" aria-label="breadcrumb">
                <a href="{{ url('homepage') }}"><i class="fas fa-home"></i> Home</a>
                {% if Product.ProductCategories|length > 0 %}
                    {% set firstCategory = Product.ProductCategories[0].Category %}
                    {% for Path in firstCategory.path %}
                        <span class="shopcart-breadcrumb__sep">/</span>
                        <a href="{{ url('product_list') }}?category_id={{ Path.id }}">{{ Path.name }}</a>
                    {% endfor %}
                {% endif %}
                <span class="shopcart-breadcrumb__sep">/</span>
                <span class="shopcart-breadcrumb__current">{{ Product.name }}</span>
            </nav>

            <!-- Product Detail Main Grid -->
            <div class="shopcart-detail-grid">
                <!-- Left Column: Gallery Showcase -->
                <div class="shopcart-detail-gallery">
                    <!-- Main Showcase Display -->
                    <div class="shopcart-detail-main-showcase">
                        <button type="button" class="shopcart-wishlist-btn shopcart-wishlist-btn--showcase{% if is_favorite %} is-active{% endif %}" data-product-id="{{ Product.id }}" aria-label="Add to Wishlist" title="{{ 'front.product.add_favorite'|trans }}">
                            <i class="{% if is_favorite %}fas{% else %}far{% endif %} fa-heart"{% if is_favorite %} style="color: #ef4444;"{% endif %}></i>
                        </button>
                        <img id="mainShowcaseImg" src="{{ firstImage }}" alt="{{ Product.name }}">
                    </div>

                    <!-- Thumbnails -->
                    {% if hasImages and Product.ProductImage|length > 1 %}
                        <div class="shopcart-detail-thumbs">
                            {% for pImage in Product.ProductImage %}
                                {% set thumbSrc = asset(pImage.fileName, 'save_image') %}
                                <div class="shopcart-detail-thumb{% if loop.first %} is-active{% endif %}" data-img="{{ thumbSrc }}" title="{{ Product.name }} - {{ loop.index }}">
                                    <img src="{{ thumbSrc }}" alt="{{ Product.name }} - {{ loop.index }}">
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <!-- Right Column: Info & Purchase Box -->
                <div class="shopcart-detail-info">
                    <!-- Title -->
                    <h1 class="shopcart-detail-title">{{ Product.name }}</h1>

                    <!-- Item Code (if available) -->
                    {% if Product.code_min %}
                        <div class="shopcart-product-code" style="font-size: 0.85rem; color: #64748b; margin-top: 4px; margin-bottom: 8px;">
                            Item Code: <strong>{{ Product.code_min }}{% if Product.code_min != Product.code_max %} ～ {{ Product.code_max }}{% endif %}</strong>
                        </div>
                    {% endif %}

                    <!-- Subtitle / Short Description -->
                    {% if Product.description_list %}
                        <p class="shopcart-detail-subtitle">{{ Product.description_list }}</p>
                    {% elseif Product.description_detail %}
                        <p class="shopcart-detail-subtitle">{{ Product.description_detail|striptags|slice(0, 160) }}</p>
                    {% endif %}

                    <!-- Rating Stars -->
                    <div class="shopcart-detail-rating">
                        <div class="shopcart-detail-stars">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <span class="shopcart-detail-review-count">(Verified Quality)</span>
                    </div>

                    <hr class="shopcart-detail-divider">

                    <!-- Price -->
                    <div class="shopcart-detail-price-box">
                        <div class="shopcart-detail-price">
                            {% if Product.hasProductClass %}
                                {% if Product.getPrice02Min == Product.getPrice02Max %}
                                    {{ Product.getPrice02Min|price }}
                                {% else %}
                                    {{ Product.getPrice02Min|price }} ～ {{ Product.getPrice02Max|price }}
                                {% endif %}
                            {% else %}
                                {{ Product.getPrice02Min|price }}
                            {% endif %}
                            {% if Product.getPrice01Min and Product.getPrice01Min > Product.getPrice02Min %}
                                <span class="shopcart-detail-oldprice" style="text-decoration: line-through; color: #94a3b8; font-size: 1.1rem; margin-left: 10px; font-weight: 500;">
                                    {{ Product.getPrice01Min|price }}
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    <hr class="shopcart-detail-divider">

                    <!-- Purchase Form -->
                    <form action="{{ url('product_add_cart', {id:Product.id}) }}" method="post" id="form1" name="form1">
                        <!-- Variant Options (if product has classes) -->
                        {% if form.classcategory_id1 is defined %}
                            <div class="shopcart-variants-section" style="margin-bottom: 20px;">
                                <div class="shopcart-variant-group">
                                    <label class="shopcart-variant-label" style="font-weight: 600; display: block; margin-bottom: 6px;">
                                        {{ form.classcategory_id1.vars.label|default('Option 1') }}
                                    </label>
                                    {{ form_widget(form.classcategory_id1, {'attr': {'class': 'form-select shopcart-variant-select', 'style': 'padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; width: 100%; max-width: 320px;'}}) }}
                                    {{ form_errors(form.classcategory_id1) }}
                                </div>
                                {% if form.classcategory_id2 is defined %}
                                    <div class="shopcart-variant-group" style="margin-top: 12px;">
                                        <label class="shopcart-variant-label" style="font-weight: 600; display: block; margin-bottom: 6px;">
                                            {{ form.classcategory_id2.vars.label|default('Option 2') }}
                                        </label>
                                        {{ form_widget(form.classcategory_id2, {'attr': {'class': 'form-select shopcart-variant-select', 'style': 'padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; width: 100%; max-width: 320px;'}}) }}
                                        {{ form_errors(form.classcategory_id2) }}
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        <!-- Quantity Stepper & Stock Warning -->
                        <div class="shopcart-qty-stock-row">
                            <div class="shopcart-qty-stepper">
                                <button type="button" class="shopcart-qty-btn" id="btnQtyMinus"><i class="fas fa-minus"></i></button>
                                <span class="shopcart-qty-input" id="shopcartQtyDisplay">1</span>
                                <button type="button" class="shopcart-qty-btn" id="btnQtyPlus"><i class="fas fa-plus"></i></button>
                            </div>
                            <div class="shopcart-stock-notice">
                                {% if Product.stockFind %}
                                    {% if Product.stockMin is not null and not Product.stockUnlimitedMin and Product.stockMin > 0 %}
                                        Only <strong>{{ Product.stockMin }} Items</strong> Left!<br>Don't miss it
                                    {% else %}
                                        <strong>In Stock</strong> & Ready to Ship
                                    {% endif %}
                                {% else %}
                                    <strong style="color: #ef4444;">Out of Stock</strong>
                                {% endif %}
                            </div>
                        </div>

                        {# Actual Quantity input synced with stepper #}
                        {{ form_widget(form.quantity, {'id': 'quantity', 'attr': {'style': 'display:none;', 'value': '1'}}) }}

                        <!-- Action Buttons -->
                        <div class="shopcart-detail-actions">
                            <button type="button" class="shopcart-btn-buynow" id="btnBuyNow">
                                Buy Now
                            </button>
                            <button type="submit" class="shopcart-btn-addcart add-cart">
                                Add to Cart
                            </button>
                            <button type="button" class="shopcart-wishlist-btn shopcart-btn-favorite-action{% if is_favorite %} is-active{% endif %}" data-product-id="{{ Product.id }}" aria-label="Add to Wishlist" title="{{ 'front.product.add_favorite'|trans }}">
                                <i class="{% if is_favorite %}fas{% else %}far{% endif %} fa-heart"{% if is_favorite %} style="color: #ef4444;"{% endif %}></i>
                            </button>
                        </div>

                        {{ form_rest(form) }}
                    </form>

                    <!-- Delivery & Service Info Card -->
                    <div class="shopcart-delivery-card">
                        <!-- Free Delivery -->
                        <div class="shopcart-delivery-item">
                            <div class="shopcart-delivery-icon">
                                <i class="fas fa-truck"></i>
                            </div>
                            <div class="shopcart-delivery-text">
                                <h4 class="shopcart-delivery-title">Free Delivery</h4>
                                <p class="shopcart-delivery-sub">
                                    <a href="#deliveryModal" onclick="event.preventDefault(); alert('Free expedited shipping available for your area on orders over ¥5,000.');">Enter your Postal code for Delivery Availability</a>
                                </p>
                            </div>
                        </div>

                        <hr class="shopcart-delivery-divider">

                        <!-- Return Delivery -->
                        <div class="shopcart-delivery-item">
                            <div class="shopcart-delivery-icon">
                                <i class="fas fa-box-open"></i>
                            </div>
                            <div class="shopcart-delivery-text">
                                <h4 class="shopcart-delivery-title">Return Delivery</h4>
                                <p class="shopcart-delivery-sub">
                                    Free 30days Delivery Returns. <a href="#returnModal" onclick="event.preventDefault(); alert('Enjoy 30-day hassle-free returns with full money back guarantee.');">Details</a>
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Product Extra Details / Specifications -->
            <div class="shopcart-detail-extra">
                <h3 class="shopcart-detail-extra-title">Product Description & Details</h3>
                <div class="shopcart-detail-extra-content">
                    {% if Product.description_detail %}
                        <p>{{ Product.description_detail|raw|nl2br }}</p>
                    {% elseif Product.description_list %}
                        <p>{{ Product.description_list }}</p>
                    {% else %}
                        <p>High quality authentic item curated by Offmarket.</p>
                    {% endif %}
                </div>
            </div>

            <!-- Related / Similar Products Section -->
            {% if Product.ProductCategories|length > 0 %}
                {% set currentCat = Product.ProductCategories[0].Category %}
                {% set similarItems = [] %}
                {% for pc in currentCat.ProductCategories %}
                    {% if pc.Product.id != Product.id and similarItems|length < 4 and pc.Product.Status.id == 1 %}
                        {% set similarItems = similarItems|merge([pc.Product]) %}
                    {% endif %}
                {% endfor %}
                {% if similarItems|length > 0 %}
                    <div class="shopcart-related-section" style="margin-top: 56px; padding-top: 40px; border-top: 1px solid #e2e8f0;">
                        <div class="shopcart-section-header" style="margin-bottom: 28px;">
                            <h2 class="shopcart-section-title">Similar Products in {{ currentCat.name }}</h2>
                            <div class="shopcart-section-track">
                                <div class="shopcart-section-track__bar"></div>
                            </div>
                        </div>

                        <div class="shopcart-product-grid shopcart-related-grid">
                            {% for simProd in similarItems %}
                                {% set simImg = simProd.ProductImage|length > 0 ? asset(simProd.ProductImage[0].fileName, 'save_image') : asset('assets/img/top/no_image_product.png') %}
                                <div class="shopcart-product-card">
                                    <div class="shopcart-product-thumb">
                                        <button type="button" class="shopcart-wishlist-btn" data-product-id="{{ simProd.id }}" aria-label="Add to Wishlist">
                                            <i class="far fa-heart"></i>
                                        </button>
                                        <a href="{{ url('product_detail', {id: simProd.id}) }}">
                                            <img src="{{ simImg }}" alt="{{ simProd.name }}">
                                        </a>
                                    </div>
                                    <div class="shopcart-product-info">
                                        <div class="shopcart-product-head">
                                            <a href="{{ url('product_detail', {id: simProd.id}) }}" class="shopcart-product-name">{{ simProd.name }}</a>
                                            <span class="shopcart-product-price">{{ simProd.getPrice02Min|price }}</span>
                                        </div>
                                        <div class="shopcart-product-desc">{{ simProd.description_list|default(simProd.description_detail|striptags|slice(0, 60)) }}</div>
                                        <a href="{{ url('product_detail', {id: simProd.id}) }}" class="shopcart-add-cart-btn">View Details</a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </section>
{% endblock %}
