{% block javascript %}
    <script>
        eccube.classCategories = {{ class_categories_as_json(Product)|raw }};

        // 規格2に選択肢を割り当てる。
        function fnSetClassCategories(form, classcat_id2_selected) {
            var $form = $(form);
            var product_id = $form.find('input[name=product_id]').val();
            var $sele1 = $form.find('select[name=classcategory_id1]');
            var $sele2 = $form.find('select[name=classcategory_id2]');
            eccube.setClassCategories($form, product_id, $sele1, $sele2, classcat_id2_selected);
        }

        {% if form.classcategory_id2 is defined %}
        fnSetClassCategories(
            $('#form1'), {{ form.classcategory_id2.vars.value|json_encode|raw }}
        );
        {% elseif form.classcategory_id1 is defined %}
        eccube.checkStock($('#form1'), {{ Product.id }}, {{ form.classcategory_id1.vars.value|json_encode|raw }}, null);
        {% endif %}
    </script>
    <script>
        $(function() {
            // bfcache無効化
            $(window).bind('pageshow', function(event) {
                if (event.originalEvent.persisted) {
                    location.reload(true);
                }
            });

            // Color Swatch & Thumbnail Interactive Switcher
            function switchProductImage(src, colorName) {
                var $mainImg = $('#mainShowcaseImg');
                $mainImg.css('opacity', '0.4');
                setTimeout(function() {
                    $mainImg.attr('src', src).css('opacity', '1');
                }, 150);
            }

            $('.shopcart-color-swatch').on('click', function() {
                $('.shopcart-color-swatch').removeClass('is-active');
                $(this).addClass('is-active');
                var imgSrc = $(this).attr('data-img');
                var colorVal = $(this).attr('data-color');
                switchProductImage(imgSrc, colorVal);

                // Update thumbnail active state
                $('.shopcart-detail-thumb').removeClass('is-active');
                $('.shopcart-detail-thumb[data-color="' + colorVal + '"]').addClass('is-active');
            });

            $('.shopcart-detail-thumb').on('click', function() {
                $('.shopcart-detail-thumb').removeClass('is-active');
                $(this).addClass('is-active');
                var imgSrc = $(this).attr('data-img');
                var colorVal = $(this).attr('data-color');
                switchProductImage(imgSrc, colorVal);

                // Update swatch active state
                $('.shopcart-color-swatch').removeClass('is-active');
                $('.shopcart-color-swatch[data-color="' + colorVal + '"]').addClass('is-active');
            });

            // Quantity Stepper Controls
            $('#btnQtyMinus').on('click', function() {
                var $qty = $('#quantity');
                var $disp = $('#shopcartQtyDisplay');
                var currentVal = parseInt($qty.val(), 10) || 1;
                if (currentVal > 1) {
                    currentVal -= 1;
                    $qty.val(currentVal);
                    $disp.text(currentVal);
                }
            });

            $('#btnQtyPlus').on('click', function() {
                var $qty = $('#quantity');
                var $disp = $('#shopcartQtyDisplay');
                var currentVal = parseInt($qty.val(), 10) || 1;
                currentVal += 1;
                $qty.val(currentVal);
                $disp.text(currentVal);
            });

            // Buy Now: Add to cart and proceed directly to checkout (2-click purchase)
            $('#btnBuyNow').on('click', function(e) {
                e.preventDefault();
                {% if form.classcategory_id1 is defined %}
                if ($('#classcategory_id1').val() == '__unselected' || $('#classcategory_id1').val() == '') {
                    $('#classcategory_id1')[0].setCustomValidity('{{ 'front.product.product_class_unselected'|trans }}');
                    return true;
                }
                {% endif %}
                if (typeof loadingOverlay === 'function') {
                    loadingOverlay();
                }
                $.ajax({
                    url: $('#form1').attr('action'),
                    type: 'POST',
                    data: $('#form1').serialize(),
                    dataType: 'html'
                }).done(function() {
                    window.location.href = "{{ path('shopping') }}";
                }).fail(function() {
                    $('#form1').submit();
                });
            });

            // Add to Cart AJAX
            $('.add-cart').on('click', function(event) {
                {% if form.classcategory_id1 is defined %}
                if ($('#classcategory_id1').val() == '__unselected' || $('#classcategory_id1').val() == '') {
                    $('#classcategory_id1')[0].setCustomValidity('{{ 'front.product.product_class_unselected'|trans }}');
                    return true;
                } else {
                    $('#classcategory_id1')[0].setCustomValidity('');
                }
                {% endif %}

                {% if form.classcategory_id2 is defined %}
                if ($('#classcategory_id2').val() == '__unselected' || $('#classcategory_id2').val() == '') {
                    $('#classcategory_id2')[0].setCustomValidity('{{ 'front.product.product_class_unselected'|trans }}');
                    return true;
                } else {
                    $('#classcategory_id2')[0].setCustomValidity('');
                }
                {% endif %}

                if ($('#quantity').val() < 1) {
                    $('#quantity')[0].setCustomValidity('{{ 'front.product.invalid_quantity'|trans }}');
                    return true;
                } else {
                    $('#quantity')[0].setCustomValidity('');
                }

                event.preventDefault();
                var $form = $('#form1');
                $.ajax({
                    url: $form.attr('action'),
                    type: $form.attr('method'),
                    data: $form.serialize(),
                    dataType: 'json',
                    beforeSend: function(xhr, settings) {
                        $('.add-cart').prop('disabled', true);
                    }
                }).done(function(data) {
                    $.each(data.messages, function() {
                        $('#ec-modal-header').text(this);
                    });
                    $('.ec-modal').show();

                    // Update header cart count
                    $.ajax({
                        url: "{{ url('block_cart') }}",
                        type: 'GET',
                        dataType: 'html'
                    }).done(function(html) {
                        $('.ec-headerRole__cart').html(html);
                    });
                }).fail(function(data) {
                    alert('{{ 'front.product.add_cart_error'|trans }}');
                }).always(function(data) {
                    $('.add-cart').prop('disabled', false);
                });
            });

            $('.ec-modal-wrap').on('click', function(e) {
                e.stopPropagation();
            });
            $('.ec-modal-overlay, .ec-modal, .ec-modal-close, .ec-inlineBtn--cancel').on('click', function() {
                $('.ec-modal').hide();
            });
        });
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": "{{ Product.name }}",
        "image": [
            "{{ app.request.schemeAndHttpHost }}{{ cur.main_img }}"
        ],
        "description": "{{ cur.subtitle }}",
        "offers": {
            "@type": "Offer",
            "url": "{{ url('product_detail', {'id': Product.id}) }}",
            "priceCurrency": "USD",
            "price": {{ cur.price }},
            "availability": "InStock"
        }
    }
    </script>
{% endblock %}

{% block main %}
    <section class="shopcart-detail-section">
        <div class="shopcart-container">
            <!-- Breadcrumb Navigation -->
            <nav class="shopcart-breadcrumb" aria-label="breadcrumb">
                <a href="{{ url('homepage') }}">Electronics</a>
                <span class="shopcart-breadcrumb__sep">/</span>
                <a href="{{ url('product_list') }}?name=Audio">Audio</a>
                <span class="shopcart-breadcrumb__sep">/</span>
                <a href="{{ url('product_list') }}?name=Headphones">Headphones</a>
                <span class="shopcart-breadcrumb__sep">/</span>
                <a href="{{ url('product_list') }}?name=Headphones">{{ cur.category }}</a>
                <span class="shopcart-breadcrumb__sep">/</span>
                <span class="shopcart-breadcrumb__current">{{ Product.name }}</span>
            </nav>

            <!-- Product Detail Main Grid -->
            <div class="shopcart-detail-grid">
                <!-- Left Column: Gallery Showcase -->
                <div class="shopcart-detail-gallery">
                    <!-- Main Showcase Display -->
                    <div class="shopcart-detail-main-showcase">
                        <img id="mainShowcaseImg" src="{{ cur.main_img }}" alt="{{ Product.name }}">
                    </div>

                    <!-- Thumbnails -->
                    <div class="shopcart-detail-thumbs">
                        {% for thumb in cur.thumbs %}
                            <div class="shopcart-detail-thumb{% if loop.first %} is-active{% endif %}" data-color="{{ thumb.color }}" data-img="{{ thumb.img }}" title="{{ thumb.name }}">
                                <img src="{{ thumb.img }}" alt="{{ thumb.name }}">
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Right Column: Info & Purchase Box -->
                <div class="shopcart-detail-info">
                    <!-- Title -->
                    <h1 class="shopcart-detail-title">{{ Product.name }}</h1>

                    <!-- Subtitle / Short Description -->
                    <p class="shopcart-detail-subtitle">{{ cur.subtitle }}</p>

                    <!-- Rating Stars -->
                    <div class="shopcart-detail-rating">
                        <div class="shopcart-detail-stars">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <span class="shopcart-detail-review-count">({{ cur.reviews }})</span>
                    </div>

                    <hr class="shopcart-detail-divider">

                    <!-- Price & Financing -->
                    <div class="shopcart-detail-price-box">
                        <div class="shopcart-detail-price">
                            ${{ cur.price }} <span class="shopcart-detail-monthly">or {{ cur.monthly }}/month</span>
                        </div>
                        <div class="shopcart-detail-financing">
                            Suggested payments with 6 months special financing
                        </div>
                    </div>

                    <hr class="shopcart-detail-divider">

                    <!-- Choose a Color -->
                    <div class="shopcart-color-section">
                        <div class="shopcart-color-title">Choose a Color</div>
                        <div class="shopcart-color-swatches">
                            {% for swatch in cur.swatches %}
                                <button type="button" class="shopcart-color-swatch shopcart-color-swatch--{{ swatch.class }}{% if loop.first %} is-active{% endif %}" data-color="{{ swatch.color }}" data-img="{{ swatch.img }}" title="{{ swatch.title }}">
                                    <span class="shopcart-color-swatch__circle"></span>
                                </button>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Quantity Stepper & Stock Warning -->
                    <div class="shopcart-qty-stock-row">
                        <div class="shopcart-qty-stepper">
                            <button type="button" class="shopcart-qty-btn" id="btnQtyMinus"><i class="fas fa-minus"></i></button>
                            <span class="shopcart-qty-input" id="shopcartQtyDisplay">1</span>
                            <button type="button" class="shopcart-qty-btn" id="btnQtyPlus"><i class="fas fa-plus"></i></button>
                        </div>
                        <div class="shopcart-stock-notice">
                            Only <strong>{{ cur.stock }} Items</strong> Left!<br>Don't miss it
                        </div>
                    </div>

                    <!-- Purchase Form -->
                    <form action="{{ url('product_add_cart', {id:Product.id}) }}" method="post" id="form1" name="form1">
                        {% if form.classcategory_id1 is defined %}
                            <div style="display: none;">
                                {{ form_widget(form.classcategory_id1) }}
                                {% if form.classcategory_id2 is defined %}
                                    {{ form_widget(form.classcategory_id2) }}
                                {% endif %}
                            </div>
                        {% endif %}

                        {# Actual Quantity input synced with stepper #}
                        {{ form_widget(form.quantity, {'id': 'quantity', 'attr': {'style': 'display:none;', 'value': '1'}}) }}

                        <!-- Action Buttons -->
                        <div class="shopcart-detail-actions">
                            <button type="button" class="shopcart-btn-buynow" id="btnBuyNow">
                                Buy Now
                            </button>
                            <button type="submit" class="shopcart-btn-addcart add-cart">
                                Add to Cart
                            </button>
                        </div>

                        {{ form_rest(form) }}
                    </form>

                    <!-- Delivery & Service Info Card -->
                    <div class="shopcart-delivery-card">
                        <!-- Free Delivery -->
                        <div class="shopcart-delivery-item">
                            <div class="shopcart-delivery-icon">
                                <i class="fas fa-truck"></i>
                            </div>
                            <div class="shopcart-delivery-text">
                                <h4 class="shopcart-delivery-title">Free Delivery</h4>
                                <p class="shopcart-delivery-sub">
                                    <a href="#deliveryModal" onclick="event.preventDefault(); alert('Free expedited shipping available for your area on orders over $50.');">Enter your Postal code for Delivery Availability</a>
                                </p>
                            </div>
                        </div>

                        <hr class="shopcart-delivery-divider">

                        <!-- Return Delivery -->
                        <div class="shopcart-delivery-item">
                            <div class="shopcart-delivery-icon">
                                <i class="fas fa-box-open"></i>
                            </div>
                            <div class="shopcart-delivery-text">
                                <h4 class="shopcart-delivery-title">Return Delivery</h4>
                                <p class="shopcart-delivery-sub">
                                    Free 30days Delivery Returns. <a href="#returnModal" onclick="event.preventDefault(); alert('Enjoy 30-day hassle-free returns with full money back guarantee.');">Details</a>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Confirmation for Add to Cart -->
                    <div class="ec-modal">
                        <div class="ec-modal-overlay">
                            <div class="ec-modal-wrap">
                                <span class="ec-modal-close"><span class="ec-icon"><img src="{{ asset('assets/icon/cross-dark.svg') }}" alt=""/></span></span>
                                <div id="ec-modal-header" class="text-center">{{ 'front.product.add_cart_complete'|trans }}</div>
                                <div class="ec-modal-box">
                                    <div class="ec-role">
                                        <span class="ec-inlineBtn--cancel">{{ 'front.product.continue'|trans }}</span>
                                        <a href="{{ url('cart') }}" class="ec-inlineBtn--action">{{ 'common.go_to_cart'|trans }}</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Extra Details / Specifications -->
            <div class="shopcart-detail-extra">
                <h3 class="shopcart-detail-extra-title">Product Description & Technical Specifications</h3>
                <div class="shopcart-detail-extra-content">
                    <p>{{ cur.desc_p1 }}</p>
                    <p>{{ cur.desc_p2 }}</p>
                </div>
            </div>

            <!-- Related / Similar Products Section -->
            <div class="shopcart-related-section" style="margin-top: 56px; padding-top: 40px; border-top: 1px solid #e2e8f0;">
                <div class="shopcart-section-header" style="margin-bottom: 28px;">
                    <h2 class="shopcart-section-title">Similar Products You May Like</h2>
                    <div class="shopcart-section-track">
                        <div class="shopcart-section-track__bar"></div>
                    </div>
                </div>

                <div class="shopcart-product-grid shopcart-related-grid">
                    {% set count = 0 %}
                    {% for rel_id, rel in catalog %}
                        {% if rel_id != (Product.id ~ '') and count < 4 %}
                            {% set count = count + 1 %}
                            {% set price_parts = rel.price|split('.') %}
                            <div class="shopcart-product-card">
                                <div class="shopcart-product-thumb">
                                    <button type="button" class="shopcart-wishlist-btn" aria-label="Add to Wishlist">
                                        <i class="far fa-heart"></i>
                                    </button>
                                    <a href="{{ url('product_detail', {id: rel.id}) }}">
                                        <img src="{{ rel.main_img }}" alt="{{ rel.name }}">
                                    </a>
                                </div>
                                <div class="shopcart-product-info">
                                    <div class="shopcart-product-head">
                                        <a href="{{ url('product_detail', {id: rel.id}) }}" class="shopcart-product-name">{{ rel.name }}</a>
                                        <span class="shopcart-product-price"><sup>$</sup>{{ price_parts[0] }}<sup>.{{ price_parts[1]|default('00') }}</sup></span>
                                    </div>
                                    <div class="shopcart-product-desc">{{ rel.subtitle }}</div>
                                    <div class="shopcart-product-rating">
                                        <span class="shopcart-stars">★★★★★</span>
                                        <span class="shopcart-rating-count">({{ rel.reviews }})</span>
                                    </div>
                                    <a href="{{ url('product_detail', {id: rel.id}) }}" class="shopcart-add-cart-btn">Add to Cart</a>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
