{% extends 'default_frame.twig' %}

{% set body_class = 'front_page' %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/css/nav_shopcart.css') }}?v={{ 'now'|date('U') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/customize.css', 'user_data') }}?v={{ 'now'|date('U') }}">
{% endblock %}

{% block javascript %}
    <script>
        $(function() {
            $('.shopcart-hero-slider').slick({
                dots: true,
                arrows: false,
                autoplay: true,
                autoplaySpeed: 5000,
                speed: 600,
                fade: true,
                cssEase: 'cubic-bezier(0.16, 1, 0.3, 1)',
                pauseOnHover: true
            });
        });
    </script>
{% endblock javascript %}

