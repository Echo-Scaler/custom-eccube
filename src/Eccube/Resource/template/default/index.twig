{% extends 'default_frame.twig' %}

{% set body_class = 'front_page' %}

{% block javascript %}
    <script>
        $(function() {
            $('.shopcart-hero-slider').slick({
                dots: true,
                arrows: false,
                autoplay: true,
                autoplaySpeed: 5000,
                speed: 600,
                fade: true,
                cssEase: 'cubic-bezier(0.16, 1, 0.3, 1)',
                pauseOnHover: true
            });
        });
    </script>
{% endblock javascript %}

{% block main %}
    <section class="shopcart-hero-section">
        <div class="shopcart-container">
            <div class="shopcart-hero-slider">
                <!-- Slide 1: Headphone Deal (Exact Match to Design) -->
                <div class="shopcart-hero-slide shopcart-hero-slide--headphone">
                    <div class="shopcart-hero-slide__inner">
                        <div class="shopcart-hero-content">
                            <h1 class="shopcart-hero-title">Grab Upto 50% Off On Selected Headphone</h1>
                            <div class="shopcart-hero-actions">
                                <a href="{{ url('product_list') }}" class="shopcart-hero-btn">Buy Now</a>
                            </div>
                        </div>
                        <div class="shopcart-hero-media">
                            <img src="{{ asset('assets/img/top/hero_headphone.jpg') }}" alt="Grab Upto 50% Off On Selected Headphone">
                        </div>
                    </div>
                </div>

                <!-- Slide 2: Smartwatch & Gadgets Deal -->
                <div class="shopcart-hero-slide shopcart-hero-slide--smartwatch">
                    <div class="shopcart-hero-slide__inner">
                        <div class="shopcart-hero-content">
                            <h2 class="shopcart-hero-title">Next-Gen Smartwatches & Audio Gear</h2>
                            <div class="shopcart-hero-actions">
                                <a href="{{ url('product_list') }}" class="shopcart-hero-btn">Explore Deals</a>
                            </div>
                        </div>
                        <div class="shopcart-hero-media">
                            <img src="{{ asset('assets/img/top/hero_smartwatch.jpg') }}" alt="Next-Gen Smartwatches & Audio Gear">
                        </div>
                    </div>
                </div>

                <!-- Slide 3: Seasonal Special Collection -->
                <div class="shopcart-hero-slide shopcart-hero-slide--bestseller">
                    <div class="shopcart-hero-slide__inner">
                        <div class="shopcart-hero-content">
                            <h2 class="shopcart-hero-title">Discover Trending Items & Daily Best Deals</h2>
                            <div class="shopcart-hero-actions">
                                <a href="{{ url('product_list') }}?orderby=1" class="shopcart-hero-btn">Shop Collection</a>
                            </div>
                        </div>
                        <div class="shopcart-hero-media">
                            <img src="{{ asset('assets/img/top/img_hero_pc01.jpg') }}" alt="Discover Trending Items">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
