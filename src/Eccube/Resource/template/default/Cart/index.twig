{% extends 'default_frame.twig' %}

{% set body_class = 'cart_page' %}

{% block main %}
<div class="sc-cart-wrapper">
    <div class="sc-cart-container">
        <!-- Breadcrumb Navigation -->
        <div class="sc-cart-breadcrumb">
            <a href="{{ path('homepage') }}"><i class="fa-solid fa-house"></i> Home</a>
            <span class="sc-cart-breadcrumb-sep">/</span>
            <span class="sc-cart-breadcrumb-current">Shopping Cart</span>
        </div>

        <!-- Flash Messages & Errors -->
        {% set productStr = app.session.flashbag.get('eccube.front.request.product') %}
        {% for error in app.session.flashbag.get('eccube.front.request.error') %}
            {% set idx = loop.index0 %}
            <div class="ec-alert-warning" style="margin-bottom: 20px;">
                <div class="ec-alert-warning__inner">
                    <div class="ec-alert-warning__inner__item">
                        <div class="ec-alert-warning__icon"><img src="{{ asset('assets/icon/exclamation-white.svg') }}"></div>
                        <div class="ec-alert-warning__text">
                            {% if productStr[idx] is defined %}
                                {{ error|trans({'%product%':productStr[idx]})|nl2br }}
                            {% else %}
                                {{ error|trans|nl2br }}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        {% for error in app.session.flashbag.get('eccube.front.cart.error') %}
            <div class="ec-alert-warning" style="margin-bottom: 20px;">
                <div class="ec-alert-warning__inner">
                    <div class="ec-alert-warning__inner__item">
                        <div class="ec-alert-warning__icon"><img src="{{ asset('assets/icon/exclamation-white.svg') }}"></div>
                        <div class="ec-alert-warning__text">{{ error|trans|nl2br }}</div>
                    </div>
                </div>
            </div>
        {% endfor %}

        {% if totalQuantity > 0 %}
            {% for CartIndex, Cart in Carts %}
                {% set cartKey = Cart.cart_key %}
                
                {% for error in app.session.flashbag.get('eccube.front.cart.' ~ cartKey ~ '.request.error') %}
                    <div class="ec-alert-warning" style="margin-bottom: 20px;">
                        <div class="ec-alert-warning__inner">
                            <div class="ec-alert-warning__inner__item">
                                <div class="ec-alert-warning__icon"><img src="{{ asset('assets/icon/exclamation-white.svg') }}"></div>
                                <div class="ec-alert-warning__text">{{ error|trans|nl2br }}</div>
                            </div>
                        </div>
                    </div>
                {% endfor %}

                <div class="sc-cart-grid">
                    <!-- ====================================================
                         LEFT COLUMN: Items & Delivery Information
                         ==================================================== -->
                    <div class="sc-cart-col-left">
                        
                        <!-- 1. Review Item And Shipping Card -->
                        <div class="sc-cart-card">
                            <div class="sc-card-header">
                                <h2 class="sc-card-title">Review Item And Shipping</h2>
                            </div>

                            <div class="sc-item-list">
                                {% for CartItem in Cart.CartItems %}
                                    {% set ProductClass = CartItem.ProductClass %}
                                    {% set Product = ProductClass.Product %}
                                    {% set isAirpods = (Product.id == 2) or ('Airpods' in Product.name) %}

                                    <div class="sc-item-row" id="scItemRow_{{ ProductClass.id }}" data-product-class-id="{{ ProductClass.id }}">
                                        <!-- Item Image & Info -->
                                        <div class="sc-item-left">
                                            <div class="sc-item-thumb">
                                                <a href="{{ url('product_detail', {id : Product.id} ) }}">
                                                    {% if isAirpods %}
                                                        <img src="{{ asset('assets/img/product/airpods_max_pink.jpg') }}" alt="{{ Product.name }}">
                                                    {% else %}
                                                        <img src="{{ asset(Product.MainListImage|no_image_product, 'save_image') }}" alt="{{ Product.name }}">
                                                    {% endif %}
                                                </a>
                                            </div>
                                            <div class="sc-item-details">
                                                <a class="sc-item-title" href="{{ url('product_detail', {id : Product.id} ) }}">
                                                    {{ Product.name }}
                                                </a>

                                                <div class="sc-item-variant">
                                                    {% if ProductClass.ClassCategory1 and ProductClass.ClassCategory1.id %}
                                                        {{ ProductClass.ClassCategory1.ClassName.name }}: {{ ProductClass.ClassCategory1 }}
                                                    {% elseif isAirpods %}
                                                        Color: Pink
                                                    {% endif %}
                                                    {% if ProductClass.ClassCategory2 and ProductClass.ClassCategory2.id %}
                                                        &nbsp;|&nbsp; {{ ProductClass.ClassCategory2.ClassName.name }}: {{ ProductClass.ClassCategory2 }}
                                                    {% endif %}
                                                </div>

                                                <span class="sc-item-stock-tag">
                                                    <i class="fa-solid fa-check"></i> In Stock
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Item Price & Quantity Stepper -->
                                        <div class="sc-item-right">
                                            <div class="sc-item-price" id="scItemPrice_{{ ProductClass.id }}">{{ CartItem.total_price|price }}</div>
                                            
                                            <div class="sc-item-qty-container">
                                                <span class="sc-item-qty-label">Quantity:</span>
                                                <div class="sc-qty-stepper">
                                                    <a href="javascript:void(0)" 
                                                       class="sc-qty-btn sc-qty-down {% if CartItem.quantity <= 1 %}is-disabled{% endif %}" 
                                                       data-url="{{ url('cart_handle_item', {'operation': 'down', 'productClassId': ProductClass.id}) }}" 
                                                       data-product-class-id="{{ ProductClass.id }}"
                                                       title="Decrease quantity">
                                                        <i class="fa-solid fa-minus"></i>
                                                    </a>

                                                    <span class="sc-qty-value" id="scQtyVal_{{ ProductClass.id }}">
                                                        {{ CartItem.quantity < 10 ? '0' ~ CartItem.quantity : CartItem.quantity }}
                                                    </span>

                                                    <a href="javascript:void(0)" 
                                                       class="sc-qty-btn sc-qty-up" 
                                                       data-url="{{ url('cart_handle_item', {'operation': 'up', 'productClassId': ProductClass.id}) }}" 
                                                       data-product-class-id="{{ ProductClass.id }}"
                                                       title="Increase quantity">
                                                        <i class="fa-solid fa-plus"></i>
                                                    </a>
                                                </div>

                                                <!-- Delete button -->
                                                <a href="javascript:void(0)" 
                                                   class="sc-item-remove-btn sc-qty-remove" 
                                                   data-url="{{ url('cart_handle_item', {'operation': 'remove', 'productClassId': ProductClass.id }) }}" 
                                                   data-product-class-id="{{ ProductClass.id }}"
                                                   data-message="Are you sure you want to remove this item from your cart?"
                                                   title="Remove item">
                                                    <i class="fa-regular fa-trash-can"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            <!-- Free Shipping Progress / Status -->
                            <div id="scFreeShippingNotice">
                                {% if BaseInfo.delivery_free_amount %}
                                    {% if is_delivery_free[cartKey] %}
                                        <div class="sc-free-shipping-notice">
                                            <i class="fa-solid fa-truck-fast sc-free-shipping-icon"></i>
                                            <div>
                                                <strong>Free Delivery Qualified!</strong> Your order qualifies for free standard shipping.
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="sc-free-shipping-notice">
                                            <i class="fa-solid fa-truck sc-free-shipping-icon"></i>
                                            <div>
                                                Add <strong>{{ least[cartKey]|price }}</strong> more to your order to unlock <strong>Free Standard Shipping</strong>!
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>

                        <!-- 2. Delivery Information Card -->
                        <div class="sc-cart-card">
                            <div class="sc-card-header">
                                <h2 class="sc-card-title">Delivery Information</h2>
                                <button type="button" class="sc-edit-btn" id="scEditDeliveryBtn">
                                    <i class="fa-solid fa-pen-to-square"></i> Edit Information
                                </button>
                            </div>

                            <div class="sc-delivery-grid">
                                <div class="sc-delivery-label">Name:</div>
                                <div class="sc-delivery-value" id="scDelivName">
                                    {% if app.user and (app.user.name01 or app.user.name02) %}
                                        {{ app.user.name01 }} {{ app.user.name02 }}
                                    {% else %}
                                        Wade Warren
                                    {% endif %}
                                </div>

                                <div class="sc-delivery-label">Address:</div>
                                <div class="sc-delivery-value" id="scDelivAddress">
                                    {% if app.user and app.user.addr01 %}
                                        {{ app.user.addr01 }} {{ app.user.addr02 }}
                                    {% else %}
                                        4140 Parker Rd. Allentown, New Mexico 31134
                                    {% endif %}
                                </div>

                                <div class="sc-delivery-label">City:</div>
                                <div class="sc-delivery-value" id="scDelivCity">
                                    {% if app.user and app.user.pref %}
                                        {{ app.user.pref.name }}
                                    {% else %}
                                        Austin
                                    {% endif %}
                                </div>

                                <div class="sc-delivery-label">Zip Code:</div>
                                <div class="sc-delivery-value" id="scDelivZip">
                                    {% if app.user and app.user.postal_code %}
                                        {{ app.user.postal_code }}
                                    {% else %}
                                        85486
                                    {% endif %}
                                </div>

                                <div class="sc-delivery-label">Mobile:</div>
                                <div class="sc-delivery-value" id="scDelivMobile">
                                    {% if app.user and app.user.phone_number %}
                                        {{ app.user.phone_number }}
                                    {% else %}
                                        +447700960054
                                    {% endif %}
                                </div>

                                <div class="sc-delivery-label">Email:</div>
                                <div class="sc-delivery-value" id="scDelivEmail">
                                    {% if app.user and app.user.email %}
                                        {{ app.user.email }}
                                    {% else %}
                                        georgia.young@example.com
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ====================================================
                         RIGHT COLUMN: Order Summary & Payment Details
                         ==================================================== -->
                    <div class="sc-cart-col-right">
                        
                        <!-- 3. Order Summery Card -->
                        <div class="sc-cart-card">
                            <div class="sc-card-header">
                                <h2 class="sc-card-title">Order Summery</h2>
                            </div>

                            <!-- Coupon Code Box -->
                            <div class="sc-coupon-wrapper">
                                <input type="text" id="scCouponInput" class="sc-coupon-input" placeholder="Enter Coupon Code">
                                <button type="button" id="scCouponBtn" class="sc-coupon-btn">Apply coupon</button>
                            </div>
                            <div id="scCouponFeedback" class="sc-coupon-feedback"></div>

                            <!-- Price Breakdown -->
                            <div class="sc-summary-list">
                                <div class="sc-summary-row">
                                    <span>Items Subtotal</span>
                                    <span id="scSummarySubtotal">{{ Cart.totalPrice|price }}</span>
                                </div>
                                <div class="sc-summary-row">
                                    <span>Shipping & Handling</span>
                                    <span style="color: #16a34a; font-weight: 600;">Free</span>
                                </div>
                                <div class="sc-summary-row" id="scDiscountRow" style="display: none;">
                                    <span>Discount (Coupon)</span>
                                    <span id="scDiscountVal" style="color: #16a34a; font-weight: 600;">-10%</span>
                                </div>
                                <div class="sc-summary-row">
                                    <span>Estimated Tax</span>
                                    <span>Included</span>
                                </div>
                                <div class="sc-summary-row is-total">
                                    <span>Total</span>
                                    <span class="sc-total-val" id="scTotalVal">{{ Cart.totalPrice|price }}</span>
                                </div>
                            </div>
                        </div>

                        <!-- 4. Payment Details Card -->
                        <div class="sc-cart-card">
                            <div class="sc-card-header">
                                <h2 class="sc-card-title">Payment Details</h2>
                            </div>

                            <!-- Payment Method Radios -->
                            <div class="sc-payment-options">
                                <!-- Option: Cash on Delivery -->
                                <div class="sc-payment-option" data-payment-type="cod">
                                    <span class="sc-radio-bullet"></span>
                                    <span class="sc-payment-label">Cash on Delivery</span>
                                </div>

                                <!-- Option: Shopcart Card -->
                                <div class="sc-payment-option" data-payment-type="shopcart">
                                    <span class="sc-radio-bullet"></span>
                                    <span class="sc-payment-label">Shopcart Card</span>
                                </div>

                                <!-- Option: Paypal -->
                                <div class="sc-payment-option" data-payment-type="paypal">
                                    <span class="sc-radio-bullet"></span>
                                    <span class="sc-payment-label">Paypal</span>
                                    <i class="fa-brands fa-paypal" style="color: #003087; font-size: 18px;"></i>
                                </div>

                                <!-- Option: Credit or Debit card (Active by default) -->
                                <div>
                                    <div class="sc-payment-option is-active" data-payment-type="card">
                                        <span class="sc-radio-bullet"></span>
                                        <span class="sc-payment-label">Credit or Debit card</span>
                                    </div>

                                    <!-- Badges: Amazon, Mastercard, VISA -->
                                    <div class="sc-payment-badges" id="scPaymentBadges">
                                        <span class="sc-badge-chip amazon">
                                            <i class="fa-brands fa-amazon-pay"></i> amazon
                                        </span>
                                        <span class="sc-badge-chip mastercard" title="Mastercard">
                                            <span class="sc-badge-circle red"></span>
                                            <span class="sc-badge-circle yellow"></span>
                                        </span>
                                        <span class="sc-badge-chip visa">VISA</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Credit Card Form Fields -->
                            <div class="sc-payment-form" id="scPaymentCardForm">
                                <div class="sc-form-group">
                                    <label class="sc-form-label" for="scPaymentEmail">Email*</label>
                                    <input type="email" id="scPaymentEmail" class="sc-form-input" placeholder="Type here...">
                                </div>

                                <div class="sc-form-group">
                                    <label class="sc-form-label" for="scCardHolder">Card Holder Name*</label>
                                    <input type="text" id="scCardHolder" class="sc-form-input" placeholder="Type here...">
                                </div>

                                <div class="sc-form-group">
                                    <label class="sc-form-label" for="scCardNumber">Card Number*</label>
                                    <input type="text" id="scCardNumber" class="sc-form-input" placeholder="•••• •••• •••• ••••" maxlength="19">
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="sc-cart-actions">
                                <a class="sc-btn-checkout" href="{{ path('cart_buystep', {'cart_key': cartKey}) }}">
                                    <i class="fa-solid fa-lock"></i> Proceed to Checkout
                                </a>
                                {% if loop.last %}
                                    <a class="sc-btn-continue" href="{{ path('homepage') }}">
                                        <i class="fa-solid fa-arrow-left"></i> Continue Shopping
                                    </a>
                                {% endif %}
                            </div>

                            <div class="sc-secure-badge">
                                <i class="fa-solid fa-shield-halved"></i>
                                <span>256-Bit SSL Encrypted & Secure Checkout</span>
                            </div>
                        </div>

                    </div>
                </div>
            {% endfor %}
        {% else %}
            <!-- ====================================================
                 EMPTY CART STATE
                 ==================================================== -->
            <div class="sc-empty-cart-card">
                <div class="sc-empty-cart-icon">
                    <i class="fa-solid fa-basket-shopping"></i>
                </div>
                <h2 class="sc-empty-cart-title">Your Cart is Empty</h2>
                <p class="sc-empty-cart-desc">
                    Looks like you haven't added anything to your cart yet. Discover our premium audio gear, wireless headphones, and accessories!
                </p>
                <a class="sc-btn-checkout" href="{{ path('product_list') }}" style="max-width: 240px; margin: 0 auto;">
                    <i class="fa-solid fa-bag-shopping"></i> Start Shopping
                </a>
            </div>
        {% endif %}
    </div>
</div>

<!-- ====================================================
     MODAL: EDIT DELIVERY INFORMATION
     ==================================================== -->
<div class="sc-modal-backdrop" id="scDeliveryModal">
    <div class="sc-modal-box">
        <div class="sc-modal-header">
            <h3 class="sc-modal-title">Edit Delivery Information</h3>
            <button type="button" class="sc-modal-close" id="scModalCloseBtn">&times;</button>
        </div>

        <div class="sc-modal-grid">
            <div class="sc-form-group is-full">
                <label class="sc-form-label" for="scInputName">Full Name</label>
                <input type="text" id="scInputName" class="sc-form-input" placeholder="e.g. Wade Warren">
            </div>

            <div class="sc-form-group is-full">
                <label class="sc-form-label" for="scInputAddress">Street Address</label>
                <input type="text" id="scInputAddress" class="sc-form-input" placeholder="e.g. 4140 Parker Rd.">
            </div>

            <div class="sc-form-group">
                <label class="sc-form-label" for="scInputCity">City</label>
                <input type="text" id="scInputCity" class="sc-form-input" placeholder="e.g. Austin">
            </div>

            <div class="sc-form-group">
                <label class="sc-form-label" for="scInputZip">Zip / Postal Code</label>
                <input type="text" id="scInputZip" class="sc-form-input" placeholder="e.g. 85486">
            </div>

            <div class="sc-form-group is-full">
                <label class="sc-form-label" for="scInputMobile">Mobile Phone</label>
                <input type="tel" id="scInputMobile" class="sc-form-input" placeholder="e.g. +447700960054">
            </div>

            <div class="sc-form-group is-full">
                <label class="sc-form-label" for="scInputEmail">Email Address</label>
                <input type="email" id="scInputEmail" class="sc-form-input" placeholder="e.g. georgia.young@example.com">
            </div>
        </div>

        <div class="sc-modal-actions">
            <button type="button" class="sc-modal-btn-cancel" id="scModalCancelBtn">Cancel</button>
            <button type="button" class="sc-modal-btn-save" id="scModalSaveBtn">Save Information</button>
        </div>
    </div>
</div>
{% endblock main %}

{% block javascript %}
<script>
$(function () {
    var isUpdating = false;

    function updateCartItem(btn, operation, productClassId, url) {
        if (isUpdating) return;
        isUpdating = true;

        var $btn = $(btn);
        var $row = $('#scItemRow_' + productClassId);
        var $qtyVal = $('#scQtyVal_' + productClassId);
        var $downBtn = $row.find('.sc-qty-down');
        var $priceVal = $('#scItemPrice_' + productClassId);

        // Visual feedback
        $qtyVal.css('opacity', '0.4');
        $btn.css('pointer-events', 'none');

        var csrfToken = $('meta[name="eccube-csrf-token"]').attr('content');

        $.ajax({
            url: url,
            type: 'PUT',
            headers: {
                'ECCUBE-CSRF-TOKEN': csrfToken,
                'X-Requested-With': 'XMLHttpRequest'
            },
            dataType: 'json'
        }).done(function (res) {
            if (res && res.success) {
                if (res.empty || res.totalQuantity === 0) {
                    location.reload();
                    return;
                }

                if (operation === 'remove' || res.quantity === 0) {
                    $row.fadeOut(200, function () {
                        $(this).remove();
                        if ($('.sc-item-row').length === 0) {
                            location.reload();
                        }
                    });
                } else {
                    // Update quantity display with bounce animation
                    $qtyVal.text(res.formattedQuantity);
                    $qtyVal.css({ transform: 'scale(1.25)', transition: 'transform 0.15s ease' });
                    setTimeout(function () {
                        $qtyVal.css('transform', 'scale(1)');
                    }, 150);

                    // Update item price
                    if (res.itemTotalPrice) {
                        $priceVal.text(res.itemTotalPrice);
                    }

                    // Update down button disabled state
                    if (res.quantity <= 1) {
                        $downBtn.addClass('is-disabled');
                    } else {
                        $downBtn.removeClass('is-disabled');
                    }
                }

                // Update Order Summary subtotal & total
                if (res.totalPrice) {
                    $('#scSummarySubtotal').text(res.totalPrice);
                    $('#scTotalVal').text(res.totalPrice);
                }

                // Update Header Cart Count Badge
                if (typeof res.totalQuantity !== 'undefined') {
                    $('.shopcart-cart-count-badge').text(res.totalQuantity);
                    $('.shopcart-cart-preview-header span').text('Shopping Cart (' + res.totalQuantity + ')');
                }

                // Update Free Shipping Notice
                if (res.isDeliveryFree) {
                    $('#scFreeShippingNotice').html(
                        '<div class="sc-free-shipping-notice">' +
                        '<i class="fa-solid fa-truck-fast sc-free-shipping-icon"></i>' +
                        '<div><strong>Free Delivery Qualified!</strong> Your order qualifies for free standard shipping.</div>' +
                        '</div>'
                    );
                } else if (res.formattedLeast) {
                    $('#scFreeShippingNotice').html(
                        '<div class="sc-free-shipping-notice">' +
                        '<i class="fa-solid fa-truck sc-free-shipping-icon"></i>' +
                        '<div>Add <strong>' + res.formattedLeast + '</strong> more to your order to unlock <strong>Free Standard Shipping</strong>!</div>' +
                        '</div>'
                    );
                }
            } else {
                location.reload();
            }
        }).fail(function (xhr) {
            console.error('AJAX cart update failed:', xhr);
            location.reload();
        }).always(function () {
            $qtyVal.css('opacity', '1');
            $btn.css('pointer-events', 'auto');
            isUpdating = false;
        });
    }

    // Bind AJAX Quantity Up
    $(document).on('click', '.sc-qty-up', function (e) {
        e.preventDefault();
        var pid = $(this).data('product-class-id');
        var url = $(this).data('url');
        updateCartItem(this, 'up', pid, url);
    });

    // Bind AJAX Quantity Down
    $(document).on('click', '.sc-qty-down', function (e) {
        e.preventDefault();
        if ($(this).hasClass('is-disabled')) return;
        var pid = $(this).data('product-class-id');
        var url = $(this).data('url');
        updateCartItem(this, 'down', pid, url);
    });

    // Bind AJAX Delete Item
    $(document).on('click', '.sc-qty-remove', function (e) {
        e.preventDefault();
        var msg = $(this).data('message') || 'Are you sure you want to remove this item from your cart?';
        if (!confirm(msg)) return;
        var pid = $(this).data('product-class-id');
        var url = $(this).data('url');
        updateCartItem(this, 'remove', pid, url);
    });
});
</script>
{% endblock javascript %}

