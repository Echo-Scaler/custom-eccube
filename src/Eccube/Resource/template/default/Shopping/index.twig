{% extends 'default_frame.twig' %}

{% form_theme form 'Form/form_div_layout.twig' %}

{% block javascript %}
    <script>
        $(function() {
            var $redirectCallback = function() {
                loadingOverlay();
                $('#shopping_order_redirect_to').val($(this).attr('data-path'));
                $('#shopping-form').attr('action', '{{ url("shopping_redirect_to") }}').submit();
                setTimeout(function () {
                    loadingOverlay("hide");
                }, 2000);
            };
            $('[data-trigger]').each(function() {
                $(this).on($(this).attr('data-trigger'), $redirectCallback);
            });

            {% if is_granted('ROLE_USER') == false %}
            var edit = $('.customer-edit');
            var hidden = $('.customer-in');
            var form = $('.customer-form');

            $('#customer').click(function() {
                $(edit).each(function(index) {
                    var name = $(this).text();
                    var input = $('<input id="edit' + index + '" type="text" class="sc-form-input" />').val(name);
                    $(form[index]).empty().append(input);
                });

                $('.non-customer-display').hide();
                $('.non-customer-edit').show();
                $('.mod-button').show();
            });

            $('#customer-ok').click(function() {
                $(form).each(function(index) {
                    $(hidden[index]).val($(form[index]).children('input').val());
                });

                var postData = {};
                $(hidden).each(function() {
                    postData[$(this).attr('name')] = $(this).val();
                });

                loadingOverlay();

                $.ajax({
                    url: "{{ url('shopping_customer') }}",
                    type: 'POST',
                    data: postData,
                    dataType: 'json'
                }).done(function(data) {
                    if (data.status == 'OK') {
                        $(form).each(function(index) {
                            $(edit[index]).empty().text($(form[index]).children('input').val());
                            $(form[index]).empty();
                        });

                        // kana field
                        $(edit[2]).empty().text(data.kana01);
                        $(edit[3]).empty().text(data.kana02);
                        $('#customer-kana01').val(data.kana01);
                        $('#customer-kana02').val(data.kana02);
                    }
                }).fail(function() {
                    alert('更新に失敗しました。入力内容を確認してください。');
                }).always(function(data) {
                    loadingOverlay('hide');
                });

                $('.non-customer-display').show();
                $('.non-customer-edit').hide();
                $('.mod-button').hide();
            });

            $('#customer-cancel').click(function() {
                $('.non-customer-display').show();
                $('.non-customer-edit').hide();
                $('.mod-button').hide();
            });
            {% endif %}
        });
    </script>
{% endblock javascript %}

{% block main %}
<div class="sc-checkout-page-container">
    <!-- Page Header -->
    <h1 class="sc-checkout-page-title">{{ 'front.shopping.title'|trans }}</h1>
    <div class="sc-checkout-divider"></div>

    <!-- 4-Step Progress Stepper -->
    <!-- 3-Step Streamlined Progress Stepper -->
    <div class="sc-checkout-stepper-wrap">
        <div class="sc-checkout-stepper">
            <!-- Step 1: Cart -->
            <div class="sc-stepper-item is-completed">
                <div class="sc-stepper-circle">1</div>
                <span class="sc-stepper-text">{{ 'front.cart.nav__cart_items'|trans }}</span>
            </div>
            
            <div class="sc-stepper-line is-completed"></div>

            <!-- Step 2: Checkout (Active) -->
            <div class="sc-stepper-item is-active">
                <div class="sc-stepper-circle">2</div>
                <span class="sc-stepper-text">{{ 'front.shopping.title'|trans }}</span>
            </div>

            <div class="sc-stepper-line"></div>

            <!-- Step 3: Order Placed -->
            <div class="sc-stepper-item">
                <div class="sc-stepper-circle">3</div>
                <span class="sc-stepper-text">{{ 'front.shopping.complete_title'|trans }}</span>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    {{ include('Shopping/alert.twig') }}

    <form id="shopping-form" method="post" action="{{ url('shopping_confirm') }}">
        {{ form_widget(form._token) }}
        {{ form_widget(form.redirect_to) }}

        <div class="sc-checkout-grid">
            <!-- Left Column: Order Details -->
            <div class="sc-checkout-main">
                
                <!-- 1. Customer Information Card -->
                <div class="sc-checkout-section-header">
                    {{ 'front.shopping.customer_info'|trans }}
                </div>

                <div class="sc-customer-info-box non-customer-display">
                    <div class="sc-info-line">
                        <span class="customer-edit customer-name01">{{ Order.name01 }}</span>
                        <span class="customer-edit customer-name02">{{ Order.name02 }}</span>
                    </div>
                    <div class="sc-info-line">
                        <span class="customer-edit customer-kana01">{{ Order.kana01 }}</span>
                        <span class="customer-edit customer-kana02">{{ Order.kana02 }}</span>
                    </div>
                    {% if Order.companyName %}
                        <div class="sc-info-line">
                            <span class="customer-edit customer-company_name">{{ Order.companyName }}</span>
                        </div>
                    {% else %}
                        <span class="customer-edit customer-company_name" style="display:none;"></span>
                    {% endif %}
                    <div class="sc-info-line">
                        〒 <span class="customer-edit customer-postal_code">{{ Order.postal_code }}</span>
                    </div>
                    <div class="sc-info-line">
                        <span class="customer-edit customer-pref">{{ Order.pref }}</span><span class="customer-edit customer-addr01">{{ Order.addr01 }}</span>　<span class="customer-edit customer-addr02">{{ Order.addr02 }}</span>
                    </div>
                    <div class="sc-info-line">
                        <span class="customer-edit customer-phone_number">{{ Order.phone_number }}</span>
                    </div>
                    <div class="sc-info-line">
                        <span class="customer-edit customer-email">{{ Order.email }}</span>
                    </div>

                    {% if is_granted('ROLE_USER') == false %}
                        <div style="margin-top: 14px;">
                            <button id="customer" class="sc-btn-pill-change" type="button">{{ 'common.change'|trans }}</button>
                        </div>
                    {% endif %}
                </div>

                {% if is_granted('ROLE_USER') == false %}
                    <div class="sc-guest-edit-wrap non-customer-edit" style="display:none;">
                        <div class="sc-guest-edit-grid">
                            <label class="sc-dropdown-label">{{ 'common.name'|trans }} *</label>
                            <div style="display: flex; gap: 8px;">
                                <span class="customer-form customer-name01" style="flex: 1;"></span>
                                <span class="customer-form customer-name02" style="flex: 1;"></span>
                            </div>
                        </div>
                        <div class="sc-guest-edit-grid">
                            <label class="sc-dropdown-label">{{ 'common.kana'|trans }} *</label>
                            <div style="display: flex; gap: 8px;">
                                <span class="customer-form customer-kana01" style="flex: 1;"></span>
                                <span class="customer-form customer-kana02" style="flex: 1;"></span>
                            </div>
                        </div>
                        <div class="sc-guest-edit-grid">
                            <label class="sc-dropdown-label">{{ 'common.company_name'|trans }}</label>
                            <div>
                                <span class="customer-form customer-company_name"></span>
                            </div>
                        </div>
                        <div class="sc-guest-edit-grid">
                            <label class="sc-dropdown-label">{{ 'common.address'|trans }} *</label>
                            <div style="display: flex; flex-direction: column; gap: 8px;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span>〒</span>
                                    <span class="customer-form customer-postal_code"></span>
                                </div>
                                <span class="customer-form customer-address_pref"></span>
                                <span class="customer-form customer-address_addr01"></span>
                                <span class="customer-form customer-address_addr02"></span>
                            </div>
                        </div>
                        <div class="sc-guest-edit-grid">
                            <label class="sc-dropdown-label">{{ 'common.phone_number'|trans }} *</label>
                            <div>
                                <span class="customer-form customer-phone_number"></span>
                            </div>
                        </div>
                        <div class="sc-guest-edit-grid">
                            <label class="sc-dropdown-label">{{ 'common.mail_address'|trans }} *</label>
                            <div>
                                <span class="customer-form customer-email"></span>
                            </div>
                        </div>

                        <div class="mod-button" style="display:none; margin-top: 14px; display: flex; gap: 10px;">
                            <button id="customer-ok" type="button" class="sc-btn-pill-change" style="background: #003d29; color: #fff; border-color: #003d29;">{{ 'common.ok'|trans }}</button>
                            <button id="customer-cancel" type="button" class="sc-btn-pill-change">{{ 'common.cancel'|trans }}</button>
                        </div>
                    </div>

                    <input type="hidden" id="customer-name01" class="customer-in" name="customer_name01" value="{{ Order.name01 }}">
                    <input type="hidden" id="customer-name02" class="customer-in" name="customer_name02" value="{{ Order.name02 }}">
                    <input type="hidden" id="customer-kana01" class="customer-in" name="customer_kana01" value="{{ Order.kana01 }}">
                    <input type="hidden" id="customer-kana02" class="customer-in" name="customer_kana02" value="{{ Order.kana02 }}">
                    <input type="hidden" id="customer-company-name" class="customer-in" name="customer_company_name" value="{{ Order.companyName }}">
                    <input type="hidden" id="customer-postal_code" class="customer-in" name="customer_postal_code" value="{{ Order.postal_code }}">
                    <input type="hidden" id="customer-pref" class="customer-in" name="customer_pref" value="{{ Order.pref }}">
                    <input type="hidden" id="customer-addr01" class="customer-in" name="customer_addr01" value="{{ Order.addr01 }}">
                    <input type="hidden" id="customer-addr02" class="customer-in" name="customer_addr02" value="{{ Order.addr02 }}">
                    <input type="hidden" id="customer-phone_number" class="customer-in" name="customer_phone_number" value="{{ Order.phone_number }}">
                    <input type="hidden" id="customer-email" class="customer-in" name="customer_email" value="{{ Order.email }}">
                {% endif %}


                <!-- 2. Delivery Information Card -->
                <div class="sc-checkout-section-header">
                    {{ 'front.shopping.delivery_info'|trans }}
                </div>

                {% for shipping in Order.shippings %}
                    {% set idx = loop.index0 %}
                    {% set isShowReducedTaxMess = false %}

                    <!-- Subheader: Delivery to & Change Button -->
                    <div class="sc-delivery-subbar">
                        <span class="sc-delivery-to-label">
                            {{ 'front.shopping.delivery_to'|trans }}{% if Order.multiple %} ({{ loop.index }}){% endif %}
                        </span>
                        <div>
                            {% if is_granted('ROLE_USER') %}
                                <button type="button" class="sc-btn-pill-change" data-id="{{ shipping.id }}" data-trigger="click" data-path="{{ path('shopping_shipping', {'id': shipping.id}) }}">
                                    {{ 'common.change'|trans }}
                                </button>
                            {% else %}
                                <button type="button" class="sc-btn-pill-change" data-id="{{ shipping.id }}" data-trigger="click" data-path="{{ path('shopping_shipping_edit', {'id': shipping.id}) }}">
                                    {{ 'common.change'|trans }}
                                </button>
                            {% endif %}
                        </div>
                    </div>

                    <div class="sc-delivery-dotted-divider"></div>

                    <!-- Ordered Products List -->
                    <div class="sc-delivery-items-list">
                        {% for orderItem in shipping.productOrderItems %}
                            {% set isAirpods = (orderItem.product is not null and ((orderItem.product.id == 2) or ('Airpods' in orderItem.product.name))) %}
                            <div class="sc-checkout-item-row">
                                <div class="sc-checkout-item-thumb">
                                    {% if isAirpods %}
                                        <img src="{{ asset('assets/img/product/airpods_max_pink.jpg') }}" alt="{{ orderItem.productName }}">
                                    {% else %}
                                        <img src="{{ asset((orderItem.product is null ? null : orderItem.product.MainListImage)|no_image_product, 'save_image') }}" alt="{{ orderItem.productName }}">
                                    {% endif %}
                                </div>
                                <div class="sc-checkout-item-info">
                                    <div class="sc-checkout-item-name">
                                        {{ orderItem.productName }}{% if is_reduced_tax_rate(orderItem) %}{{ 'common.reduced_tax_rate_symbol'|trans }}{% set isShowReducedTaxMess = true %}{% endif %}
                                    </div>
                                    {% if orderItem.productClass is not null and orderItem.productClass.classCategory1 %}
                                        <div class="sc-checkout-item-class">{{ orderItem.productClass.classCategory1.className.name }}：{{ orderItem.productClass.classCategory1 }}</div>
                                    {% endif %}
                                    {% if orderItem.productClass is not null and orderItem.productClass.classCategory2 %}
                                        <div class="sc-checkout-item-class">{{ orderItem.productClass.classCategory2.className.name }}：{{ orderItem.productClass.classCategory2 }}</div>
                                    {% endif %}
                                    <div class="sc-checkout-item-price-line">
                                        {{ orderItem.priceIncTax|price }} × {{ orderItem.quantity|number_format }}
                                        <span class="sc-checkout-item-subtotal">Subtotal: {{ orderItem.totalPrice|price }}</span>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <!-- Shipping Recipient Address Block -->
                    <div class="sc-checkout-address-block">
                        <div class="sc-info-line">{{ shipping.name01 }} {{ shipping.name02 }} ({{ shipping.kana01 }} {{ shipping.kana02 }})</div>
                        <div class="sc-info-line">〒 {{ shipping.postal_code }} {{ shipping.pref }}{{ shipping.addr01 }} {{ shipping.addr02 }}</div>
                        <div class="sc-info-line">{{ shipping.phone_number }}</div>
                    </div>

                    <!-- Delivery Options Dropdowns (Provider, Date, Time) -->
                    <div class="sc-checkout-dropdowns-grid">
                        <div class="sc-dropdown-group">
                            <label class="sc-dropdown-label">{{ 'front.shopping.delivery_provider'|trans }}</label>
                            {{ form_widget(form.Shippings[idx].Delivery, { 'attr': { 'class': 'sc-form-select', 'data-trigger': 'change' }}) }}
                            <div class="sc-form-error">{{ form_errors(form.Shippings[idx].Delivery) }}</div>
                        </div>
                        <div class="sc-dropdown-group">
                            <label class="sc-dropdown-label">{{ 'front.shopping.delivery_date'|trans }}</label>
                            {{ form_widget(form.Shippings[idx].shipping_delivery_date, {'attr': {'class': 'sc-form-select'}}) }}
                            <div class="sc-form-error">{{ form_errors(form.Shippings[idx].shipping_delivery_date) }}</div>
                        </div>
                        <div class="sc-dropdown-group">
                            <label class="sc-dropdown-label">{{ 'front.shopping.delivery_time'|trans }}</label>
                            {{ form_widget(form.Shippings[idx].DeliveryTime, {'attr': {'class': 'sc-form-select'}}) }}
                            <div class="sc-form-error">{{ form_errors(form.Shippings[idx].DeliveryTime) }}</div>
                        </div>
                    </div>
                {% endfor %}

                <div class="sc-multiple-shipping-action">
                    <button type="button" class="sc-btn-pill-change" data-trigger="click" data-path="{{ path('shopping_shipping_multiple') }}">
                        {{ 'front.shopping.to_multiple'|trans }}
                    </button>
                </div>


                <!-- 3. Payment Method Card -->
                <div class="sc-checkout-section-header">
                    {{ 'front.shopping.payment_info'|trans }}
                </div>

                <div class="sc-payment-cards-grid">
                    {% for key, child in form.Payment %}
                        {% set Payment = form.Payment.vars.choices[key].data %}
                        <label class="sc-payment-card-item">
                            <div class="sc-payment-card-left">
                                {{ form_widget(child, { 'attr': { 'data-trigger': 'change' }}) }}
                            </div>
                            {% if Payment.payment_image is not null %}
                                <div class="sc-payment-card-badge">
                                    <img src="{{ asset(Payment.payment_image, 'save_image') }}" alt="{{ child.vars.label }}">
                                </div>
                            {% endif %}
                        </label>
                    {% endfor %}
                </div>
                <div class="sc-form-error">{{ form_errors(form.Payment) }}</div>


                <!-- 4. Point Information Card (Optional) -->
                {% if BaseInfo.isOptionPoint and Order.Customer is not null %}
                    <div class="sc-checkout-section-header">
                        {{ 'front.shopping.point_info'|trans }}
                    </div>
                    <div class="sc-point-card-body">
                        <p class="sc-point-available-text">
                            {{ 'front.shopping.available_point'|trans({ '%point%': Order.Customer.Point|number_format }) }}
                        </p>
                        <div class="sc-point-input-row">
                            {{ form_widget(form.use_point, { 'attr': { 'type': 'text', 'class': 'sc-form-input', 'data-trigger': 'change' }}) }}
                            <span class="sc-point-unit">pt</span>
                        </div>
                        <div class="sc-form-error">{{ form_errors(form.use_point) }}</div>
                    </div>
                {% endif %}


                <!-- 5. Message to Store Card -->
                <div class="sc-checkout-section-header">
                    {{ 'front.shopping.message_info'|trans }}
                </div>
                <div class="sc-message-card-body">
                    {{ form_widget(form.message, {'attr': {'class': 'sc-form-textarea', 'placeholder': 'front.shopping.message_placeholder'|trans, 'rows': '4'}}) }}
                    <div class="sc-form-error">{{ form_errors(form.message) }}</div>
                </div>

                <!-- 6. Active Trade Laws (Disclosures) -->
                {% for activeTradeLaw in activeTradeLaws|filter(t => t.name and t.description) %}
                    <div class="sc-checkout-section-header">
                        {{ activeTradeLaw.name }}
                    </div>
                    <div class="sc-message-card-body" style="line-height: 1.7; color: #4a5568; font-size: 14px;">
                        {{ activeTradeLaw.description|raw }}
                    </div>
                {% endfor %}
            </div>

            <!-- Right Column: Sticky Order Summary -->
            <div class="sc-checkout-aside">
                <div class="sc-checkout-summary-box">
                    <!-- Subtotal -->
                    <div class="sc-summary-line">
                        <span class="sc-summary-lbl">{{ 'common.subtotal'|trans }}</span>
                        <span class="sc-summary-amt">{{ Order.subtotal|price }}</span>
                    </div>

                    <!-- Charges -->
                    <div class="sc-summary-line">
                        <span class="sc-summary-lbl">{{ 'common.charge'|trans }}</span>
                        <span class="sc-summary-amt">{{ Order.charge|price }}</span>
                    </div>

                    <!-- Shipping Charge -->
                    <div class="sc-summary-line">
                        <span class="sc-summary-lbl">{{ 'common.delivery_fee'|trans }}</span>
                        <span class="sc-summary-amt">{{ Order.deliveryFeeTotal|price }}</span>
                    </div>

                    <!-- Discount (if applicable) -->
                    {% if Order.taxable_discount < 0 %}
                        <div class="sc-summary-line">
                            <span class="sc-summary-lbl">{{ 'common.discount'|trans }}</span>
                            <span class="sc-summary-amt">{{ Order.taxable_discount|price }}</span>
                        </div>
                    {% endif %}

                    {% for item in Order.tax_free_discount_items %}
                        <div class="sc-summary-line">
                            <span class="sc-summary-lbl">{{ item.product_name }}</span>
                            <span class="sc-summary-amt">{{ item.total_price|price }}</span>
                        </div>
                    {% endfor %}

                    <div class="sc-summary-sep"></div>

                    <!-- Total -->
                    <div class="sc-summary-line sc-total-line">
                        <span class="sc-summary-lbl">{{ 'common.total'|trans }}</span>
                        <div class="sc-total-val-wrap">
                            <span class="sc-total-price">{{ Order.taxable_total|price }}</span>
                            <span class="sc-tax-tag-normal">{{ 'common.tax_include'|trans }}</span>
                        </div>
                    </div>

                    <div class="sc-summary-sep"></div>

                    <!-- Payment Total (Coral Red) -->
                    <div class="sc-summary-line sc-payment-line">
                        <span class="sc-summary-lbl">{{ 'common.payment_total'|trans }}</span>
                        <div class="sc-payment-val-wrap">
                            <span class="sc-payment-price">{{ Order.payment_total|price }}</span>
                            <span class="sc-tax-tag-coral">{{ 'common.tax_include'|trans }}</span>
                        </div>
                    </div>

                    <!-- Tax Rate Breakdown -->
                    {% for rate, total in Order.total_by_tax_rate %}
                        <div class="sc-summary-tax-rate-row">
                            [ {{ 'common.tax_rate_target'|trans({ '%rate%': rate }) }} &nbsp; {{ total|price }} ({{ 'common.tax_amount'|trans }} {{ Order.tax_by_tax_rate[rate]|price }}) ]
                        </div>
                    {% endfor %}

                    <div class="sc-summary-sep"></div>

                    <!-- Points Summary (if enabled) -->
                    {% if BaseInfo.isOptionPoint and Order.Customer is not null %}
                        <div class="sc-summary-line">
                            <span class="sc-summary-lbl">{{ 'front.shopping.use_point'|trans }}</span>
                            <span class="sc-summary-amt">{{ Order.UsePoint|number_format }} pt</span>
                        </div>
                        <div class="sc-summary-line sc-bold-line">
                            <span class="sc-summary-lbl sc-bold-lbl">{{ 'front.shopping.add_point'|trans }}</span>
                            <span class="sc-summary-amt sc-bold-amt">{{ Order.AddPoint|number_format }} pt</span>
                        </div>
                    {% endif %}

                    <!-- Action Buttons -->
                    <div class="sc-summary-actions">
                        <button type="submit" class="sc-btn-review sc-btn-place-order">
                            <i class="fa-solid fa-lock" style="margin-right: 8px;"></i>{{ 'front.shopping.checkout'|trans }}
                        </button>
                        <a href="{{ url('cart') }}" class="sc-btn-back-cart">
                            {{ 'front.shopping.back_to_cart'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
{% endblock %}
