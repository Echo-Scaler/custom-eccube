{% extends 'default_frame.twig' %}

{% set body_class = 'cart_page' %}

{% block main %}
<div class="sc-checkout-page-container">
    <!-- Page Header -->
    <h1 class="sc-checkout-page-title">{{ 'front.shopping.complete_title'|trans }}</h1>
    <div class="sc-checkout-divider"></div>

    <!-- 3-Step Streamlined Progress Stepper -->
    <div class="sc-checkout-stepper-wrap">
        <div class="sc-checkout-stepper">
            <!-- Step 1: Cart -->
            <div class="sc-stepper-item is-completed">
                <div class="sc-stepper-circle"><i class="fa-solid fa-check" style="font-size: 13px;"></i></div>
                <span class="sc-stepper-text">{{ 'front.cart.nav__cart_items'|trans }}</span>
            </div>
            
            <div class="sc-stepper-line is-completed"></div>

            <!-- Step 2: Checkout -->
            <div class="sc-stepper-item is-completed">
                <div class="sc-stepper-circle"><i class="fa-solid fa-check" style="font-size: 13px;"></i></div>
                <span class="sc-stepper-text">{{ 'front.shopping.title'|trans }}</span>
            </div>

            <div class="sc-stepper-line is-completed"></div>

            <!-- Step 3: Order Placed (Active Complete) -->
            <div class="sc-stepper-item is-active">
                <div class="sc-stepper-circle" style="background-color: #22c55e;">
                    <i class="fa-solid fa-check" style="font-size: 15px; color: #ffffff;"></i>
                </div>
                <span class="sc-stepper-text" style="color: #22c55e; font-weight: 700;">{{ 'front.shopping.complete_title'|trans }}</span>
            </div>
        </div>
    </div>

    <!-- Order Success Card -->
    <div class="sc-complete-card">
        <div class="sc-complete-icon-wrap">
            <div class="sc-complete-icon">
                <i class="fa-solid fa-check"></i>
            </div>
        </div>

        <h2 class="sc-complete-title">{{ 'front.shopping.complete_message__title'|trans }}</h2>
        <p class="sc-complete-desc">
            {{ 'front.shopping.complete_message__body'|trans|nl2br }}
        </p>

        {% if Order.id %}
            <div class="sc-complete-order-badge">
                <span class="sc-order-badge-lbl">{{ 'front.shopping.order_no'|trans }}:</span>
                <span class="sc-order-badge-val">#{{ Order.orderNo }}</span>
            </div>

            <!-- Order Details Quick Summary -->
            <div class="sc-complete-summary-grid">
                <div class="sc-complete-summary-col">
                    <div class="sc-summary-col-label"><i class="fa-solid fa-location-dot" style="margin-right: 6px; color: #42b4a5;"></i> Delivery To</div>
                    <div class="sc-summary-col-text">
                        <strong>{{ Order.name01 }} {{ Order.name02 }}</strong><br>
                        〒{{ Order.postal_code }} {{ Order.pref }}{{ Order.addr01 }} {{ Order.addr02 }}<br>
                        {{ Order.phone_number }}
                    </div>
                </div>
                <div class="sc-complete-summary-col">
                    <div class="sc-summary-col-label"><i class="fa-solid fa-credit-card" style="margin-right: 6px; color: #42b4a5;"></i> Payment & Amount</div>
                    <div class="sc-summary-col-text">
                        <strong>{{ Order.paymentMethod }}</strong><br>
                        Total Paid: <span style="font-size: 18px; font-weight: 700; color: #e0564c;">{{ Order.payment_total|price }}</span> (Tax Incl.)<br>
                        Email: {{ Order.email }}
                    </div>
                </div>
            </div>
        {% endif %}

        {% if Order.complete_message is not empty %}
            <div class="sc-complete-custom-msg">
                {{ Order.complete_message|raw|purify }}
            </div>
        {% endif %}

        <div class="sc-complete-actions">
            {% if hasNextCart %}
                <a class="sc-btn-complete-primary" href="{{ url('cart') }}">
                    <i class="fa-solid fa-cart-shopping" style="margin-right: 8px;"></i>{{ 'front.shopping.continue'|trans }}
                </a>
            {% else %}
                <a class="sc-btn-complete-primary" href="{{ url('homepage') }}">
                    <i class="fa-solid fa-house" style="margin-right: 8px;"></i>{{ 'common.go_to_top'|trans }}
                </a>
            {% endif %}
            
            {% if is_granted('ROLE_USER') %}
                <a class="sc-btn-complete-secondary" href="{{ url('mypage') }}">
                    <i class="fa-solid fa-user" style="margin-right: 8px;"></i>{{ 'front.block.login.mypage'|trans }}
                </a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
