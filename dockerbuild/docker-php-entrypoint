#!/bin/sh
set -e

if [ -n "${USER_ID}" ]; then
    usermod -u ${USER_ID} -o www-data
fi
if [ -n "${GROUP_ID}" ]; then
    groupmod -g ${GROUP_ID} www-data
fi

if [ ! -d /var/www/html/vendor/bin ]; then
    composer install \
        --no-scripts \
        --no-autoloader \
        --no-plugins \
        -d ${APACHE_DOCUMENT_ROOT}
    composer dumpautoload -o --apcu
    chown -R www-data: vendor
fi

bin/console doctrine:query:sql 'select * from dtb_base_info' > /dev/null 2>&1 || {
    if [ -z ${DATABASE_URL} ]; then
        cp .env.dist .env
    fi
    composer run-script installer-scripts
    composer run-script auto-scripts
    # Disable set -e for chown/chmod to prevent exit on permission errors (e.g. .git files on macOS bind mount)
    set +e
    find ${APACHE_DOCUMENT_ROOT} \( -path ${APACHE_DOCUMENT_ROOT}/vendor -prune \) -or \( -path ${APACHE_DOCUMENT_ROOT}/.git -prune \) -or -print0 \
        | xargs -0 chown www-data:www-data 2>/dev/null
    find ${APACHE_DOCUMENT_ROOT} \( -path ${APACHE_DOCUMENT_ROOT}/vendor -prune \) -or \( -path ${APACHE_DOCUMENT_ROOT}/.git -prune \) -or \( -type d -print0 \) \
      | xargs -0 chmod g+s 2>/dev/null
    set -e
}

printenv | cut -d= -f1 | grep -E '^(APP_|TRUSTED_|DATABASE_|MAILER_|ECCUBE_)' | awk '{print "PassEnv "$1}' > /etc/apache2/conf-enabled/eccube_env.conf

# first arg is `-f` or `--some-option`
if [ "${1#-}" != "$1" ]; then
	set -- apache2-foreground "$@"
fi

exec "$@"
