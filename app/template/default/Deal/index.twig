{#
This file is part of EC-CUBE
Deals & Mega Discounts Page
#}
{% extends 'default_frame.twig' %}

{% set body_class = 'deal_page' %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/css/nav_shopcart.css') }}?v={{ 'now'|date('U') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/customize.css', 'user_data') }}?v={{ 'now'|date('U') }}">
{% endblock %}

{% block javascript %}
    <script>
        eccube.productsClassCategories = {
            {% for Product in pagination %}
            "{{ Product.id|escape('js') }}": {{ class_categories_as_json(Product)|raw }}{% if loop.last == false %}, {% endif %}
            {% endfor %}
        };

        $(function() {
            // Live Deal Countdown Timer
            function updateDealCountdown() {
                var now = new Date();
                // Set target countdown to midnight in 2 days from fixed anchor
                var target = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 2, 23, 59, 59);
                var diff = Math.max(0, target - now);

                var days = Math.floor(diff / (1000 * 60 * 60 * 24));
                var hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
                var mins = Math.floor((diff / (1000 * 60)) % 60);
                var secs = Math.floor((diff / 1000) % 60);

                $('#dealCountDays').text(String(days).padStart(2, '0'));
                $('#dealCountHours').text(String(hours).padStart(2, '0'));
                $('#dealCountMins').text(String(mins).padStart(2, '0'));
                $('#dealCountSecs').text(String(secs).padStart(2, '0'));
            }
            updateDealCountdown();
            setInterval(updateDealCountdown, 1000);

            // AJAX loader function for seamless navigation without page refresh
            var isDealLoading = false;
            function loadDealPage(url, shouldScroll, isPopState) {
                if (isDealLoading) return;
                isDealLoading = true;

                var $catalog = $('.deal-catalog-section');
                $catalog.addClass('is-loading');

                // Add or show loading indicator
                if (!$catalog.find('.deal-loading-indicator').length) {
                    $catalog.append('<div class="deal-loading-indicator"><i class="fas fa-spinner fa-spin"></i> Updating Deals...</div>');
                }

                $.ajax({
                    url: url,
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    dataType: 'html'
                }).done(function(html) {
                    try {
                        var parser = new DOMParser();
                        var doc = parser.parseFromString(html, 'text/html');

                        // 1. Update Breadcrumb
                        var newBreadcrumb = doc.querySelector('.deal-breadcrumb');
                        if (newBreadcrumb && document.querySelector('.deal-breadcrumb')) {
                            document.querySelector('.deal-breadcrumb').innerHTML = newBreadcrumb.innerHTML;
                        }

                        // 2. Update Spotlight section
                        var newSpotlight = doc.querySelector('.deal-spotlight-section');
                        var currentSpotlight = document.querySelector('.deal-spotlight-section');
                        if (newSpotlight) {
                            if (currentSpotlight) {
                                currentSpotlight.innerHTML = newSpotlight.innerHTML;
                                currentSpotlight.style.display = '';
                            } else {
                                var catNav = document.querySelector('.deal-category-nav-section');
                                if (catNav) {
                                    catNav.insertAdjacentElement('afterend', newSpotlight);
                                }
                            }
                        } else if (currentSpotlight) {
                            currentSpotlight.style.display = 'none';
                        }

                        // 3. Update Category Pills
                        var newPills = doc.querySelector('.deal-category-pills');
                        if (newPills && document.querySelector('.deal-category-pills')) {
                            document.querySelector('.deal-category-pills').innerHTML = newPills.innerHTML;
                        }

                        // 4. Update Main Catalog (Count, Filters, Product Grid, Pagination)
                        var newCatalog = doc.querySelector('.deal-catalog-section');
                        if (newCatalog && document.querySelector('.deal-catalog-section')) {
                            document.querySelector('.deal-catalog-section').innerHTML = newCatalog.innerHTML;
                        }

                        // 5. Update browser history / URL
                        if (!isPopState && window.history && window.history.pushState) {
                            window.history.pushState(null, '', url);
                        }

                        // 6. Update document title
                        if (doc.title) {
                            document.title = doc.title;
                        }

                        // 7. Re-initialize wishlist buttons
                        if (window.initShopcartWishlist) {
                            window.initShopcartWishlist();
                        }

                        // 8. Optional smooth scroll to top of category pills
                        if (shouldScroll) {
                            var $target = $('.deal-category-nav-section');
                            if ($target.length) {
                                $('html, body').animate({ scrollTop: $target.offset().top - 15 }, 300);
                            }
                        }
                    } catch (err) {
                        console.error('Error updating deals page:', err);
                        window.location.href = url;
                    }
                }).fail(function() {
                    // Fallback to standard navigation on error
                    window.location.href = url;
                }).always(function() {
                    isDealLoading = false;
                    $('.deal-catalog-section').removeClass('is-loading');
                    $('.deal-loading-indicator').remove();
                });
            }

            // 1. Category Menu Pills Click (Do not refresh page!)
            $(document).on('click', '.deal-cat-pill', function(e) {
                e.preventDefault();
                var $pill = $(this);
                var targetUrl = $pill.attr('href');

                if (!targetUrl || targetUrl === '#' || $pill.hasClass('is-active')) {
                    return;
                }

                // Immediate visual active indicator
                $('.deal-cat-pill').removeClass('is-active');
                $pill.addClass('is-active');

                loadDealPage(targetUrl, false, false);
            });

            // 2. Toolbar Filter Dropdowns (Discount & Sorting) without page reload
            $(document).on('change', '.deal-filter-select', function() {
                var $form = $('#dealFilterForm');
                if ($form.length) {
                    var targetUrl = $form.attr('action') + '?' + $form.serialize();
                    loadDealPage(targetUrl, false, false);
                }
            });

            // 3. Pagination Links Click without page reload
            $(document).on('click', '.deal-page-link', function(e) {
                var targetUrl = $(this).attr('href');
                if (!targetUrl || targetUrl === '#' || $(this).hasClass('is-active')) {
                    return;
                }
                e.preventDefault();
                loadDealPage(targetUrl, true, false);
            });

            // 4. Browser History Back / Forward navigation
            window.addEventListener('popstate', function() {
                loadDealPage(window.location.href, false, true);
            });

            // 5. Header Categories Dropdown items clicked while on deals page
            $(document).on('click', '.shopcart-cat-menu a[data-category-id]', function(e) {
                var catId = $(this).data('category-id');
                if (catId) {
                    e.preventDefault();
                    $('.shopcart-dropdown.is-open').removeClass('is-open');
                    var $pill = $('.deal-cat-pill[href*="category_id=' + catId + '"]');
                    if ($pill.length) {
                        $pill.trigger('click');
                    } else {
                        var targetUrl = "{{ url('deal_page') }}?category_id=" + catId;
                        loadDealPage(targetUrl, true, false);
                    }
                }
            });

            // 6. Header "Deals" link clicked while already on deals page
            $(document).on('click', '.shopcart-nav-link[href*="deal"]', function(e) {
                if (window.location.pathname.indexOf('deal') !== -1) {
                    e.preventDefault();
                    var $allPill = $('.deal-cat-pill').first();
                    if ($allPill.length) {
                        $allPill.trigger('click');
                    }
                }
            });

            // Add to cart with direct transition to cart (delegated for dynamically loaded cards)
            $(document).on('click', '.deal-add-cart-btn', function(e) {
                var $btn = $(this);
                var $form = $btn.closest('form');
                var $qty = $form.find('.quantity');

                if ($qty.length && parseInt($qty.val(), 10) < 1) {
                    $qty[0].setCustomValidity('{{ "front.product.invalid_quantity"|trans|default("Please enter 1 or more.") }}');
                    return true;
                } else if ($qty.length) {
                    $qty[0].setCustomValidity('');
                }

                e.preventDefault();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Adding...');

                $.ajax({
                    url: $form.attr('action'),
                    type: $form.attr('method') || 'POST',
                    data: $form.serialize(),
                    dataType: 'json'
                }).done(function(data) {
                    if (data.done) {
                        window.location.href = "{{ url('cart') }}";
                    } else {
                        var msg = (data.messages && data.messages.length > 0) ? data.messages.join("\n") : '{{ "front.product.add_cart_error"|trans|default("Could not add item to cart.") }}';
                        alert(msg);
                        $btn.prop('disabled', false).html('<i class="fas fa-shopping-cart"></i> Add to Cart');
                    }
                }).fail(function() {
                    alert('{{ "front.product.add_cart_error"|trans|default("Could not add item to cart.") }}');
                    $btn.prop('disabled', false).html('<i class="fas fa-shopping-cart"></i> Add to Cart');
                });
            });
        });
    </script>
{% endblock %}

{% block main %}
    {% set current_loc = app.request.get('_locale')|default(app.request.locale) %}
    {% set category_en_map = {
        'Furniture': 'Furniture',
        'Headphone': 'Headphone',
        'Shoe': 'Shoe',
        'Bag': 'Bag',
        'Laptop': 'Laptop',
        'Book': 'Book'
    } %}
    {% set category_ja_map = {
        'Furniture': '家具',
        'Headphone': 'ヘッドフォン',
        'Shoe': '靴',
        'Bag': 'バッグ',
        'Laptop': 'ノートパソコン',
        'Book': '本'
    } %}
    {% set category_my_map = {
        'Furniture': 'ပရိဘောဂ',
        'Headphone': 'နားကြပ်',
        'Shoe': 'ဖိနပ်',
        'Bag': 'အိတ်',
        'Laptop': 'လက်ပ်တော့',
        'Book': 'စာအုပ်'
    } %}

    <div class="deal-page-wrap">
        <!-- Breadcrumbs -->
        <div class="shopcart-container">
            <nav class="deal-breadcrumb" aria-label="breadcrumb">
                <a href="{{ url('homepage') }}"><i class="fas fa-home"></i> Home</a>
                <span class="deal-breadcrumb-sep"><i class="fas fa-chevron-right"></i></span>
                <span class="deal-breadcrumb-current">Deals</span>
                {% if current_category %}
                    {% set cur_cat_name = current_category.name %}
                    {% if current_loc == 'ja' and category_ja_map[cur_cat_name] is defined %}
                        {% set cur_cat_name = category_ja_map[cur_cat_name] %}
                    {% elseif current_loc == 'my' and category_my_map[cur_cat_name] is defined %}
                        {% set cur_cat_name = category_my_map[cur_cat_name] %}
                    {% endif %}
                    <span class="deal-breadcrumb-sep"><i class="fas fa-chevron-right"></i></span>
                    <span class="deal-breadcrumb-current">{{ cur_cat_name }}</span>
                {% endif %}
            </nav>
        </div>

        <!-- Deal Hero & Banner -->
        <section class="deal-hero-section">
            <div class="shopcart-container">
                <div class="deal-hero-card">
                    <div class="deal-hero-card__glow"></div>
                    <div class="deal-hero-content">
                        <div class="deal-badge-pill">
                            <span class="pulse-dot"></span> 🔥 MEGA SAVINGS EVENT • LIMITED TIME
                        </div>
                        <h1 class="deal-hero-title">Exclusive Deals & Mega Discounts</h1>
                        <p class="deal-hero-desc">
                            Save up to 60% on genuine wireless headphones, premium laptops, ergonomic designer furniture, running footwear, and lifestyle gear. Handpicked bargains with 30-day money-back guarantee.
                        </p>

                        <!-- Live Countdown Timer -->
                        <div class="deal-countdown-box">
                            <span class="deal-countdown-title"><i class="far fa-clock"></i> Deals Refresh In:</span>
                            <div class="deal-countdown-units">
                                <div class="deal-countdown-unit">
                                    <span class="deal-countdown-val" id="dealCountDays">02</span>
                                    <span class="deal-countdown-lbl">Days</span>
                                </div>
                                <span class="deal-countdown-colon">:</span>
                                <div class="deal-countdown-unit">
                                    <span class="deal-countdown-val" id="dealCountHours">14</span>
                                    <span class="deal-countdown-lbl">Hours</span>
                                </div>
                                <span class="deal-countdown-colon">:</span>
                                <div class="deal-countdown-unit">
                                    <span class="deal-countdown-val" id="dealCountMins">38</span>
                                    <span class="deal-countdown-lbl">Mins</span>
                                </div>
                                <span class="deal-countdown-colon">:</span>
                                <div class="deal-countdown-unit">
                                    <span class="deal-countdown-val" id="dealCountSecs">52</span>
                                    <span class="deal-countdown-lbl">Secs</span>
                                </div>
                            </div>
                        </div>

                        <!-- Highlights Quick Stats -->
                        <div class="deal-hero-stats">
                            <div class="deal-stat-item">
                                <i class="fas fa-fire-alt deal-stat-icon"></i>
                                <div>
                                    <strong>{{ total_deals_count|default(300) }}+</strong>
                                    <span>Active Deals</span>
                                </div>
                            </div>
                            <div class="deal-stat-item">
                                <i class="fas fa-percentage deal-stat-icon"></i>
                                <div>
                                    <strong>Up to 60%</strong>
                                    <span>Instant Savings</span>
                                </div>
                            </div>
                            <div class="deal-stat-item">
                                <i class="fas fa-truck-fast deal-stat-icon"></i>
                                <div>
                                    <strong>Free Express</strong>
                                    <span>Fast Delivery</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hero Media Showcase Graphic -->
                    <div class="deal-hero-media">
                        <div class="deal-hero-badge-tag">
                            <span class="tag-title">UP TO</span>
                            <span class="tag-val">60%</span>
                            <span class="tag-sub">OFF</span>
                        </div>
                        <img src="{{ asset('assets/img/top/prod_gaming_headphone.jpg') }}" alt="Special Deals Showcase" class="deal-hero-img">
                    </div>
                </div>
            </div>
        </section>

        <!-- Category Deal Filter Pills -->
        <section class="deal-category-nav-section">
            <div class="shopcart-container">
                <div class="deal-category-pills">
                    <a href="{{ url('deal_page', {'discount': current_discount, 'orderby': current_orderby}) }}"
                       class="deal-cat-pill{% if current_category_id is empty or current_category_id == 0 %} is-active{% endif %}">
                        <i class="fas fa-border-all"></i>
                        <span>All Deals</span>
                        <span class="deal-cat-count">{{ total_deals_count }}</span>
                    </a>
                    {% for cat in categories %}
                        {% set cat_name = cat.name %}
                        {% if current_loc == 'ja' and category_ja_map[cat_name] is defined %}
                            {% set cat_name = category_ja_map[cat_name] %}
                        {% elseif current_loc == 'my' and category_my_map[cat_name] is defined %}
                            {% set cat_name = category_my_map[cat_name] %}
                        {% endif %}
                        <a href="{{ url('deal_page', {'category_id': cat.id, 'discount': current_discount, 'orderby': current_orderby}) }}"
                           class="deal-cat-pill{% if current_category_id == cat.id %} is-active{% endif %}">
                            <span>{{ cat_name }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Spotlight Deal of the Day (3 Hot Picks) -->
        {% if spotlight_products|length > 0 and (current_category_id is empty or current_category_id == 0) and (current_discount == 'all') %}
        <section class="deal-spotlight-section">
            <div class="shopcart-container">
                <div class="deal-section-header">
                    <div class="deal-section-title-wrap">
                        <span class="deal-mini-badge"><i class="fas fa-bolt"></i> LIMITED QUANTITY</span>
                        <h2 class="deal-section-title">Flash Deals of the Day</h2>
                    </div>
                    <p class="deal-section-desc">Act fast — these hand-selected featured deals are available while supplies last.</p>
                </div>

                <div class="deal-spotlight-grid">
                    {% for sp in spotlight_products %}
                        {% set pClass = sp.ProductClasses|first %}
                        {% set origPrice = pClass.price01|default(pClass.price02 * 1.5) %}
                        {% set salePrice = pClass.price02 %}
                        {% set discountPercent = (origPrice > salePrice) ? ((origPrice - salePrice) / origPrice * 100)|round : 45 %}
                        {% set claimedPercent = 65 + ((sp.id * 11) % 30) %}

                        <div class="deal-spotlight-card">
                            <div class="deal-spotlight-media">
                                <a href="{{ url('product_detail', {'id': sp.id}) }}">
                                    <img src="{{ asset(sp.main_list_image|no_image_product, 'save_image') }}" alt="{{ sp.name }}" class="deal-spotlight-img">
                                </a>
                                <div class="deal-discount-badge deal-discount-badge--pulse">
                                    -{{ discountPercent }}% OFF
                                </div>
                                <button type="button" class="deal-wishlist-btn shopcart-wishlist-btn" data-product-id="{{ sp.id }}" aria-label="Add to Wishlist">
                                    <i class="far fa-heart"></i>
                                </button>
                            </div>

                            <div class="deal-spotlight-body">
                                <div class="deal-spotlight-meta">
                                    <span class="deal-spotlight-tag"><i class="fas fa-fire"></i> Best Deal</span>
                                    <div class="deal-stars">
                                        <span class="stars-filled">★★★★★</span>
                                        <span class="stars-count">({{ (sp.id * 19 + 48) % 180 + 20 }})</span>
                                    </div>
                                </div>

                                <h3 class="deal-spotlight-name">
                                    <a href="{{ url('product_detail', {'id': sp.id}) }}">{{ sp.name }}</a>
                                </h3>

                                <div class="deal-pricing-row">
                                    <div class="deal-price-current">{{ salePrice|price }}</div>
                                    <div class="deal-price-orig">{{ origPrice|price }}</div>
                                    <div class="deal-save-badge">Save {{ (origPrice - salePrice)|price }}</div>
                                </div>

                                <!-- Claim Progress Bar -->
                                <div class="deal-progress-wrap">
                                    <div class="deal-progress-label">
                                        <span><strong>{{ claimedPercent }}%</strong> claimed</span>
                                        <span>Only {{ (sp.id * 3) % 9 + 3 }} left!</span>
                                    </div>
                                    <div class="deal-progress-bar">
                                        <div class="deal-progress-fill" style="width: {{ claimedPercent }}%;"></div>
                                    </div>
                                </div>

                                <!-- Action Button -->
                                {% if spotlight_forms[sp.id] is defined %}
                                    {% set form = spotlight_forms[sp.id] %}
                                    <form name="dealForm{{ sp.id }}" id="dealForm{{ sp.id }}"
                                          action="{{ url('product_add_cart', {id: sp.id}) }}" method="post"
                                          class="deal-action-form">
                                        <input type="hidden" name="{{ form.quantity.vars.full_name }}" value="1" class="quantity">
                                        {% do form.quantity.setRendered() %}
                                        {% if form.classcategory_id1 is defined %}
                                            {{ form_widget(form.classcategory_id1, {'attr': {'style': 'display:none;'}}) }}
                                        {% endif %}
                                        {% if form.classcategory_id2 is defined %}
                                            {{ form_widget(form.classcategory_id2, {'attr': {'style': 'display:none;'}}) }}
                                        {% endif %}
                                        {{ form_rest(form) }}
                                        <div class="deal-btn-group">
                                            <button type="submit" class="deal-btn deal-btn--primary deal-add-cart-btn" data-cartid="{{ sp.id }}">
                                                <i class="fas fa-shopping-cart"></i> Claim Deal
                                            </button>
                                            <a href="{{ url('product_detail', {'id': sp.id}) }}" class="deal-btn deal-btn--outline">
                                                View Info
                                            </a>
                                        </div>
                                    </form>
                                {% else %}
                                    <a href="{{ url('product_detail', {'id': sp.id}) }}" class="deal-btn deal-btn--primary">
                                        View Deal <i class="fas fa-arrow-right"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
        {% endif %}

        <!-- Main Deals Catalog Section -->
        <section class="deal-catalog-section">
            <div class="shopcart-container">
                <!-- Toolbar with Discount & Sorting Controls -->
                <div class="deal-toolbar">
                    <div class="deal-toolbar-count">
                        {% if pagination.totalItemCount > 0 %}
                            Showing <strong class="deal-count-num">{{ pagination.totalItemCount }}</strong> Deals Available
                        {% else %}
                            No deals match the selected criteria.
                        {% endif %}
                    </div>

                    <form id="dealFilterForm" method="get" action="{{ url('deal_page') }}" class="deal-toolbar-filters">
                        {% if current_category_id %}
                            <input type="hidden" name="category_id" value="{{ current_category_id }}">
                        {% endif %}

                        <!-- Discount Threshold Filter -->
                        <div class="deal-filter-group">
                            <label class="deal-filter-label" for="discountSelect"><i class="fas fa-tag"></i> Discount:</label>
                            <select name="discount" id="discountSelect" class="deal-filter-select">
                                <option value="all"{% if current_discount == 'all' %} selected{% endif %}>All Discounts</option>
                                <option value="50"{% if current_discount == '50' %} selected{% endif %}>50% Off or More</option>
                                <option value="40"{% if current_discount == '40' %} selected{% endif %}>40% Off or More</option>
                                <option value="30"{% if current_discount == '30' %} selected{% endif %}>30% Off or More</option>
                                <option value="20"{% if current_discount == '20' %} selected{% endif %}>20% Off or More</option>
                            </select>
                        </div>

                        <!-- Sorting -->
                        <div class="deal-filter-group">
                            <label class="deal-filter-label" for="orderbySelect"><i class="fas fa-sort-amount-down"></i> Sort:</label>
                            <select name="orderby" id="orderbySelect" class="deal-filter-select">
                                <option value="discount_desc"{% if current_orderby == 'discount_desc' %} selected{% endif %}>Biggest Discount %</option>
                                <option value="price_asc"{% if current_orderby == 'price_asc' %} selected{% endif %}>Price: Low to High</option>
                                <option value="price_desc"{% if current_orderby == 'price_desc' %} selected{% endif %}>Price: High to Low</option>
                                <option value="newest"{% if current_orderby == 'newest' %} selected{% endif %}>Newest Deals</option>
                            </select>
                        </div>
                    </form>
                </div>

                <!-- Products Grid -->
                {% if pagination.totalItemCount > 0 %}
                    <div class="deal-products-grid">
                        {% for Product in pagination %}
                            {% set pc = Product.ProductClasses|first %}
                            {% set p01 = pc.price01|default(pc.price02 * 1.2) %}
                            {% set p02 = pc.price02 %}
                            {% set discountRate = (p01 > p02) ? ((p01 - p02) / p01 * 100)|round : 15 %}

                            <div class="deal-product-card">
                                <div class="deal-product-card__thumb">
                                    <a href="{{ url('product_detail', {'id': Product.id}) }}">
                                        <img src="{{ asset(Product.main_list_image|no_image_product, 'save_image') }}"
                                             alt="{{ Product.name }}"
                                             class="deal-product-img"
                                             {% if loop.index > 4 %}loading="lazy"{% endif %}>
                                    </a>
                                    <span class="deal-badge-ribbon">-{{ discountRate }}%</span>
                                    <button type="button" class="deal-card-wishlist shopcart-wishlist-btn" data-product-id="{{ Product.id }}" aria-label="Add to Wishlist">
                                        <i class="far fa-heart"></i>
                                    </button>
                                </div>

                                <div class="deal-product-card__body">
                                    <a href="{{ url('product_detail', {'id': Product.id}) }}" class="deal-product-title" title="{{ Product.name }}">
                                        {{ Product.name }}
                                    </a>

                                    <p class="deal-product-desc">
                                        {{ Product.description_list|default(Product.description_detail|default('High performance gear with verified authenticity and fast delivery.'))|striptags|slice(0, 65) }}…
                                    </p>

                                    <div class="deal-card-stars">
                                        <span class="stars-filled">★★★★★</span>
                                        <span class="stars-count">({{ (Product.id * 17 + 43) % 150 + 12 }})</span>
                                    </div>

                                    <div class="deal-card-pricing">
                                        <div class="deal-card-price-current">{{ p02|price }}</div>
                                        <div class="deal-card-price-orig">{{ p01|price }}</div>
                                    </div>

                                    <div class="deal-card-savings">
                                        Save {{ (p01 - p02)|price }} ({{ discountRate }}% OFF)
                                    </div>

                                    <!-- Add to Cart Form -->
                                    {% if Product.stock_find and forms[Product.id] is defined %}
                                        {% set form = forms[Product.id] %}
                                        <form name="dealForm{{ Product.id }}" id="dealForm{{ Product.id }}"
                                              action="{{ url('product_add_cart', {id: Product.id}) }}" method="post"
                                              class="deal-card-form">
                                            <input type="hidden" name="{{ form.quantity.vars.full_name }}" value="1" class="quantity">
                                            {% do form.quantity.setRendered() %}
                                            {% if form.classcategory_id1 is defined %}
                                                {{ form_widget(form.classcategory_id1, {'attr': {'style': 'display:none;'}}) }}
                                            {% endif %}
                                            {% if form.classcategory_id2 is defined %}
                                                {{ form_widget(form.classcategory_id2, {'attr': {'style': 'display:none;'}}) }}
                                            {% endif %}
                                            {{ form_rest(form) }}
                                            <button type="submit" class="deal-card-btn deal-add-cart-btn" data-cartid="{{ Product.id }}">
                                                <i class="fas fa-shopping-cart"></i> Add to Cart
                                            </button>
                                        </form>
                                    {% else %}
                                        <button type="button" class="deal-card-btn deal-card-btn--disabled" disabled>
                                            <i class="fas fa-ban"></i> Out of Stock
                                        </button>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <!-- Pagination -->
                    {% if pagination.paginationData.pageCount > 1 %}
                        <div class="deal-pagination-wrap">
                            <div class="deal-pagination">
                                {% if pagination.paginationData.previous is defined %}
                                    <a href="{{ url('deal_page', {'page': pagination.paginationData.previous, 'category_id': current_category_id, 'discount': current_discount, 'orderby': current_orderby}) }}"
                                       class="deal-page-link deal-page-prev">
                                        <i class="fas fa-chevron-left"></i> Prev
                                    </a>
                                {% endif %}

                                {% for pageNum in pagination.paginationData.pagesInRange %}
                                    {% if pageNum == pagination.paginationData.current %}
                                        <span class="deal-page-link is-active">{{ pageNum }}</span>
                                    {% else %}
                                        <a href="{{ url('deal_page', {'page': pageNum, 'category_id': current_category_id, 'discount': current_discount, 'orderby': current_orderby}) }}"
                                           class="deal-page-link">
                                            {{ pageNum }}
                                        </a>
                                    {% endif %}
                                {% endfor %}

                                {% if pagination.paginationData.next is defined %}
                                    <a href="{{ url('deal_page', {'page': pagination.paginationData.next, 'category_id': current_category_id, 'discount': current_discount, 'orderby': current_orderby}) }}"
                                       class="deal-page-link deal-page-next">
                                        Next <i class="fas fa-chevron-right"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}

                {% else %}
                    <!-- Empty State -->
                    <div class="deal-empty-state">
                        <div class="deal-empty-icon">
                            <i class="fas fa-tags"></i>
                        </div>
                        <h3>No Deals Found</h3>
                        <p>No products currently match the selected category and discount criteria. Try selecting another filter or category.</p>
                        <a href="{{ url('deal_page') }}" class="deal-btn deal-btn--primary">Browse All Deals</a>
                    </div>
                {% endif %}
            </div>
        </section>

        <!-- Trust Badges & Guarantee Banner -->
        <section class="deal-trust-section">
            <div class="shopcart-container">
                <div class="deal-trust-grid">
                    <div class="deal-trust-item">
                        <div class="deal-trust-icon"><i class="fas fa-certificate"></i></div>
                        <div class="deal-trust-content">
                            <h4>100% Genuine Products</h4>
                            <p>Direct from verified manufacturers with full warranty.</p>
                        </div>
                    </div>
                    <div class="deal-trust-item">
                        <div class="deal-trust-icon"><i class="fas fa-truck-fast"></i></div>
                        <div class="deal-trust-content">
                            <h4>Express Delivery</h4>
                            <p>Fast, trackable shipping to your doorstep with insured packaging.</p>
                        </div>
                    </div>
                    <div class="deal-trust-item">
                        <div class="deal-trust-icon"><i class="fas fa-rotate-left"></i></div>
                        <div class="deal-trust-content">
                            <h4>30-Day Money Back</h4>
                            <p>Hassle-free returns and refunds if you're not completely thrilled.</p>
                        </div>
                    </div>
                    <div class="deal-trust-item">
                        <div class="deal-trust-icon"><i class="fas fa-headset"></i></div>
                        <div class="deal-trust-content">
                            <h4>24/7 Dedicated Support</h4>
                            <p>Our expert support team is always here to assist your order.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
